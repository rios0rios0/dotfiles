# The daily backup of the home-secrets folders, started by secrets-backup.timer.
#
# The work lives in ~/.local/bin/secrets-backup: it packs the folders secretsBackup.sources names
# (~/.john, ~/.sqlmap, ~/.kube/config and ~/.kube/config-files), encrypts the tar with the age
# identity in ~/.ssh/secrets-backup-key, rotates ~/.local/share/secrets-backups and copies the
# archive to the personal OneDrive. A failed copy fails this unit. `secrets-restore` brings an
# archive back; see .docs/secrets-backup.md.
#
# No [Install] on purpose: enabling this unit at boot would only add a second backup on machines
# that boot daily. The timer is what gets enabled -- it starts this unit.

[Unit]
Description=Encrypted backup of the home-secrets folders
Documentation=https://github.com/rios0rios0/dotfiles/blob/main/.docs/secrets-backup.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/secrets-backup
