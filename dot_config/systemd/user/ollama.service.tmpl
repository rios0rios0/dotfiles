{{- $llm := includeTemplate "lib-local-llm.tmpl" . | fromJson -}}
# Ollama, the local model server behind `claude-local`.
#
# A user unit, where Ollama's own installer writes a system one: the binary, the models and this
# file all live under $HOME, so installing and reconfiguring the server needs no root, and its
# settings come from .chezmoidata/local-llm.yaml instead of a drop-in under /etc that nothing
# tracks. run_onchange_after_linux-009-setup-ollama.sh installs the binary behind ExecStart and
# restarts this unit whenever the rendered file changes.
#
# See CLAUDE.md, "Local Model for Claude Code".

[Unit]
Description=Ollama local model server (claude-local)
Documentation=https://docs.ollama.com/faq

[Service]
ExecStart=%h/.local/bin/ollama serve
# Loopback only: the API has no authentication.
Environment=OLLAMA_HOST=127.0.0.1:11434
# Must equal CLAUDE_CODE_MAX_CONTEXT_TOKENS in claude-local; both are rendered from one value.
Environment=OLLAMA_CONTEXT_LENGTH={{ int $llm.contextTokens }}
Environment=OLLAMA_KV_CACHE_TYPE={{ $llm.kvCacheType }}
Environment=OLLAMA_KEEP_ALIVE={{ $llm.keepAlive }}
# One model in VRAM at a time: claude-local maps every Claude Code tier to the same model, and
# a second one would only evict it on a GPU this size.
Environment=OLLAMA_MAX_LOADED_MODELS=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
