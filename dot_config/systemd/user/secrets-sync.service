# The hourly sync of the home-secrets folders, started by secrets-sync.timer.
#
# The work lives in ~/.local/bin/secrets-sync: it merges this device's ~/.kube/config-files,
# ~/.john/john.pot and ~/.sqlmap/output with the other devices' snapshots in the personal OneDrive
# (%OneDriveConsumer%\Backup\sync), then publishes this device's own. A delete the guard stops, a
# snapshot that does not authenticate and a hub that cannot be reached each fail this unit; see
# .docs/secrets-sync.md.
#
# No [Install] on purpose: the timer is what gets enabled -- it starts this unit.

[Unit]
Description=Sync of the home-secrets folders through the personal OneDrive
Documentation=https://github.com/rios0rios0/dotfiles/blob/main/.docs/secrets-sync.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/secrets-sync
