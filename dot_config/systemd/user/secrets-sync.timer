# The hourly run of secrets-sync.service: merges the other devices' snapshots of the home-secrets
# folders and publishes this device's.
#
# Hourly rather than daily like the backups: a sync is only as current as its last run on each
# device. Persistent=true runs an hour missed while the machine was off at the next opportunity, so
# a WSL that just started catches up at once. Each device writes only its own snapshot, so two
# devices running at the same minute never touch the same file.

[Unit]
Description=Hourly sync of the home-secrets folders through the personal OneDrive
Documentation=https://github.com/rios0rios0/dotfiles/blob/main/.docs/secrets-sync.md

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
