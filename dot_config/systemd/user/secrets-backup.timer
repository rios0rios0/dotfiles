# The daily run of secrets-backup.service: one encrypted snapshot of the home-secrets folders.
#
# Persistent=true makes a 03:45 missed while the machine was off run at the next opportunity; WSL
# is often off overnight. 03:45 rather than OmniRoute's 03:30 so the two daily backups do not start
# together.

[Unit]
Description=Daily encrypted backup of the home-secrets folders
Documentation=https://github.com/rios0rios0/dotfiles/blob/main/.docs/secrets-backup.md

[Timer]
OnCalendar=*-*-* 03:45:00
Persistent=true

[Install]
WantedBy=timers.target
