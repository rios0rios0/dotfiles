{{- $deviceName := .deviceName -}}
{{- $username := (trimPrefix (upper .chezmoi.hostname) .chezmoi.username) | replace "\\" "" }}

{{- /* OS-dependent paths and executables */ -}}
{{- $windowsHome := printf "C:/Users/%s" $username -}}
{{- $defaultHome := .chezmoi.homeDir -}}

{{- $program := "op-ssh-sign" -}}
{{- /* Linux keeps the file git checks signatures against beside ~/.config/git/ignore, because .ssh
       is not deployed there; Windows and Android keep theirs in ~/.ssh. */ -}}
{{- $allowedSignersFile := printf "%s/.config/git/allowed_signers" $defaultHome -}}
{{- $excludesFile := printf "%s/.gitignore" $defaultHome -}}
{{- $sshCommand := "ssh" -}}

{{- if eq .chezmoi.os "windows" -}}
    {{- /* 1Password's signer is wherever its installer put it: an app execution alias in
           %LOCALAPPDATA%\Microsoft\WindowsApps, which is on PATH, for the Microsoft Store build;
           Program Files for the machine-wide installer; %LOCALAPPDATA%\1Password for the per-user
           one. A path that does not exist fails every commit with "cannot exec", so the one that
           exists wins, and Program Files is only the fallback. */ -}}
    {{- $program = "C:/Program Files/1Password/app/8/op-ssh-sign.exe" -}}
    {{- $perUser := printf "%s/1Password/app/8/op-ssh-sign.exe" (env "LOCALAPPDATA" | replace "\\" "/") -}}
    {{- with lookPath "op-ssh-sign.exe" -}}
        {{- $program = . | replace "\\" "/" -}}
    {{- else -}}
        {{- if and (not (stat $program)) (stat $perUser) -}}
            {{- $program = $perUser -}}
        {{- end -}}
    {{- end -}}
    {{- $allowedSignersFile = printf "%s/.ssh/allowed_signers" $windowsHome -}}
    {{- $excludesFile = printf "%s/.gitignore" $windowsHome -}}
    {{- $sshCommand = "C:/Windows/System32/OpenSSH/ssh.exe" -}}
{{- else if and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel | toString)) -}}
    {{- /* Linux's ssh-keygen signs with the key in 1Password's agent, which the SSH agent bridge
           serves at ~/.ssh/agent.sock (SSH_AUTH_SOCK, from dot_zshenv.tmpl) -- the way Android signs
           with its own agent at the same path. 1Password's Windows signer would need to know where
           1Password is installed and the Windows user's name, and WSL can tell neither. */ -}}
    {{- $program = "ssh-keygen" -}}
    {{- $sshCommand = "ssh.exe" -}}
{{- else if eq .chezmoi.os "android" -}}
    {{- $program = "ssh-keygen" -}}
    {{- $allowedSignersFile = printf "%s/.ssh/allowed_signers" $defaultHome -}}
    {{- $sshCommand = "ssh" -}}
{{- end -}}

{{- /* Fetch device credential list (cached by chezmoi) */ -}}
{{- warnf "[gitconfig] fetching Device: %s..." $deviceName -}}
{{- $deviceNotes := "" -}}
{{- range (onepassword (printf "Device: %s" $deviceName) "personal" "my").fields -}}
  {{- if and (eq .label "notesPlain") (hasKey . "value") -}}
    {{- $deviceNotes = .value -}}
  {{- end -}}
{{- end -}}

{{- /* Default user fields from first SSH entry */ -}}
{{- $defaultUsername := "" -}}
{{- $defaultUserEmail := "" -}}
{{- $defaultUserSigningkey := "" -}}
{{- range splitList "\n" $deviceNotes -}}
  {{- $entry := . | trim -}}
  {{- if ne $entry "" -}}
    {{- $type := index (split ":" $entry) "_0" -}}
    {{- $name := trimPrefix (printf "%s:" $type) $entry | trim -}}
    {{- if eq $type "ssh" -}}
      {{- warnf "[gitconfig] matched \"%s\" for SSH defaults" $name -}}
      {{- $item := onepassword $name "Private" "my" -}}
      {{- $f := dict -}}
      {{- range $item.fields -}}
        {{- if hasKey . "value" -}}
          {{- $_ := set $f .label .value -}}
        {{- end -}}
      {{- end -}}
      {{- $defaultUsername = index $f "ssh username" -}}
      {{- $defaultUserEmail = index $f "ssh email" -}}
      {{- $defaultUserSigningkey = index $f "public key" -}}
      {{- break -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

[user]
    name = "{{ $defaultUsername }}"
    email = "{{ $defaultUserEmail }}"
    signingkey = "{{ $defaultUserSigningkey }}"
[gpg]
    format = ssh
[gpg "ssh"]
    program = "{{ $program }}"
    allowedSignersFile = "{{ $allowedSignersFile }}"
[commit]
    gpgsign = true
    template = ~/.gitmessage
[tag]
    forceSignAnnotated = true
[alias]
    pom = push origin main -u
    cim = "!f() { git commit -m \"$*\"; }; f"
    ci = commit
    co = checkout
    cm = checkout main
    cb = checkout -b
    st = status -sb
    sf = show --name-only
    lg = log --pretty=format:'%Cred%h%Creset %C(bold)%cr%Creset %Cgreen<%an>%Creset %s' --max-count=30
    incoming = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' ..@{u})
    outgoing = !(git fetch --quiet && git log --pretty=format:'%C(yellow)%h %C(white)- %C(red)%an %C(white)- %C(cyan)%d%Creset %s %C(white)- %ar%Creset' @{u}..)
    unstage = reset HEAD --
    undo = checkout --
    rollback = reset --soft HEAD~1

    # gpg signing
{{- range splitList "\n" $deviceNotes -}}
  {{- $entry := . | trim -}}
  {{- if ne $entry "" -}}
    {{- $type := index (split ":" $entry) "_0" -}}
    {{- $name := trimPrefix (printf "%s:" $type) $entry | trim -}}
    {{- if eq $type "gpg" -}}
      {{- warnf "[gitconfig] matched \"%s\" for GPG alias" $name -}}
      {{- $item := onepassword $name "Private" "my" -}}
      {{- $f := dict -}}
      {{- range $item.fields -}}
        {{- if hasKey . "value" -}}
          {{- $_ := set $f .label .value -}}
        {{- end -}}
      {{- end -}}
      {{- $gpgAlias := index $f "gpg alias" -}}
      {{- $gpgUsername := index $f "gpg username" -}}
      {{- $gpgEmail := index $f "gpg email" -}}
      {{- $gpgFingerprint := index $f "fingerprint" }}
    gpg{{ $gpgAlias }} = !(git config user.name '{{ $gpgUsername }}' && git config user.email '{{ $gpgEmail }}' && git config --replace-all user.signingkey {{ $gpgFingerprint }} && git config gpg.format openpgp)
    {{- end -}}
  {{- end -}}
{{- end }}

    # ssh signing
{{- range splitList "\n" $deviceNotes -}}
  {{- $entry := . | trim -}}
  {{- if ne $entry "" -}}
    {{- $type := index (split ":" $entry) "_0" -}}
    {{- $name := trimPrefix (printf "%s:" $type) $entry | trim -}}
    {{- if eq $type "ssh" -}}
      {{- warnf "[gitconfig] matched \"%s\" for SSH alias" $name -}}
      {{- $item := onepassword $name "Private" "my" -}}
      {{- $f := dict -}}
      {{- range $item.fields -}}
        {{- if hasKey . "value" -}}
          {{- $_ := set $f .label .value -}}
        {{- end -}}
      {{- end -}}
      {{- $sshAlias := index $f "ssh alias" -}}
      {{- $sshUsername := index $f "ssh username" -}}
      {{- $sshEmail := index $f "ssh email" -}}
      {{- $sshPublicKey := index $f "public key" }}
    ssh{{ $sshAlias }} = !(git config user.name '{{ $sshUsername }}' && git config user.email '{{ $sshEmail }}' && git config --replace-all user.signingkey '{{ $sshPublicKey }}' && git config gpg.format ssh)
    {{- end -}}
  {{- end -}}
{{- end }}
[core]
    autocrlf = input
    editor = vim
    excludesfile = "{{ $excludesFile }}"
    sshCommand = "{{ $sshCommand }}"
{{- if eq .chezmoi.os "linux" }}
    hooksPath = "{{ .chezmoi.homeDir }}/.local/share/ggshield/git-hooks"
{{- end }}
[merge]
    commit = yes
    ff = yes
[push]
    autoSetupRemote = true

# machine-local config kept out of this public repo (e.g. work identities through includeIf);
# git skips the include silently when the file does not exist
[include]
    path = ~/.gitconfig.local
