{{- /* Claude Code's ~/.claude. Linux gets only the look: settings.json, which carries it there,
     and the status line script it runs. The trust dialog in .claude.json serves Windows and
     Android, which get no status line: it is a bash script that forks jq on every redraw. The
     AI content in ~/.claude -- CLAUDE.md, rules, agents, commands and skills -- is aisync's, not
     chezmoi's: see "AI Rules Sync" in CLAUDE.md. dot_claude/modify_settings.json holds the look. */ -}}
{{- if eq .chezmoi.os "linux" }}
.claude/.claude.json
{{- else }}
.claude/statusline-command.sh
{{- end }}

{{- /* Files shared between Windows and Android.
     They are only needed on these systems, so ignore them on all others (i.e. on Linux). */ -}}
{{- if not (or (eq .chezmoi.os "windows") (eq .chezmoi.os "android")) }}
.ssh
{{- end }}

{{- /* ggshield's pre-commit hook is wired on Linux alone (`hooksPath` in dot_gitconfig.tmpl), and
     .config/git/ignore exists only to answer the `git check-ignore` that hook runs: see the comment
     at the top of dot_config/git/ignore. */ -}}
{{- if ne .chezmoi.os "linux" }}
.config/git/ignore
{{- end }}

{{- /* Linux features ship systemd user units, each gated on what it serves. .config/systemd
     itself is ignored only when none applies, so that Windows, Android and a machine with no use
     for any of them never get an empty ~/.config/systemd/user. */ -}}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel | toString)) -}}
{{- $localLLM := and (eq .chezmoi.os "linux") (includeTemplate "lib-local-llm.tmpl" . | fromJson).enabled -}}

{{- /* WSL-exclusive files. The SSH agent bridge relays a Windows named pipe, so it is
     meaningless on bare-metal Linux -- there is no Windows agent to reach, and the unit would
     point at an npiperelay.exe that is never installed. The tailscale wrapper runs Windows'
     Tailscale CLI, which is WSL's tailnet client; on bare metal it would shadow tailscaled's own
     CLI. The OmniRoute backups serve the local stack, which runs from a checkout on WSL alone.
     Gated on the kernel rather than the OS because "linux" alone does not distinguish WSL from
     bare metal. */ -}}
{{- if not $wsl }}
.config/systemd/user/ssh-agent-bridge.socket
.config/systemd/user/ssh-agent-bridge@.service
.config/systemd/user/omniroute-backup.service
.config/systemd/user/omniroute-backup.timer
.local/bin/tailscale
.local/bin/omniroute-backup
{{- end }}

{{- /* The local model server (Ollama): Linux with an NVIDIA driver, unless
     .chezmoidata/local-llm.yaml switches it off. Gated on the GPU rather than on WSL, because
     nothing in it depends on Windows and a bare-metal machine with a GPU runs it the same way.
     The OS check lives here, not in lib-local-llm.tmpl, because lookPath finds nvidia-smi.exe on
     a Windows machine with an NVIDIA card too. claude-omni, which reaches it through OmniRoute,
     ships on every Linux machine below: a GPU on the tailnet or a cloud provider needs none here. */ -}}
{{- if not $localLLM }}
.config/systemd/user/ollama.service
{{- end }}

{{- if not (or $wsl $localLLM) }}
.config/systemd
{{- end }}

