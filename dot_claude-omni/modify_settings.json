{{- /* chezmoi:modify-template */ -}}
{{- /*
  Gives claude-omni the look of the regular claude: the keys from lib-claude-look.tmpl,
  merged into ~/.claude-omni/settings.json. Its profile is a CLAUDE_CONFIG_DIR of its own,
  so Claude Code reads nothing from ~/.claude/settings.json there, and a session through
  OmniRoute would otherwise keep whatever its onboarding picked, with no status line. Every
  other key belongs to the profile: /model choices, for one, land here, and claude-omni's
  picker starts from the one saved last.

  Shipped with claude-omni, under the same gate in .chezmoiignore. A key whose value
  differs is set back; when none does, the current content is returned byte for byte. A
  real change re-serialises the file, and toPrettyJson then sorts its keys. Invalid JSON
  fails the template instead of replacing the file.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $updated := list -}}
{{- range $key, $value := includeTemplate "lib-claude-look.tmpl" . | fromJson -}}
{{-   if ne (toJson (get $settings $key)) (toJson $value) -}}
{{-     $_ := set $settings $key $value -}}
{{-     $updated = append $updated $key -}}
{{-   end -}}
{{- end -}}
{{- if $updated -}}
{{-   warnf "[claude-omni] set %s in ~/.claude-omni/settings.json" (join ", " $updated) -}}
{{-   toPrettyJson $settings -}}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
