{{- $llm := includeTemplate "lib-local-llm.tmpl" . | fromJson -}}
{{- if $llm.enabled -}}
#!/bin/bash

# Installs Ollama as a systemd user service and pulls the model OmniRoute serves from this GPU.
#
# Ollama's own installer is a root script: it streams the release into /usr/local without
# checking a digest, creates an `ollama` system user, and leaves its settings to a drop-in under
# /etc that nothing tracks. Everything here lives under $HOME instead: the release, unpacked into
# ~/.local/share/ollama/<version> once its digest matches the pin below; the models, in ~/.ollama;
# and the unit, which chezmoi renders from .chezmoidata/local-llm.yaml. So the install needs no
# root, and the configuration is versioned with the rest of this repository.
#
# `run_onchange_` rather than `run_once_`. A version bump changes the pins below, and a new model
# or context window changes the digest of the rendered unit recorded on the next line, so either
# re-runs this script, which restarts the server on the new binary and settings, checks that it
# found a GPU, and pulls a model that is not there yet:
#   unit {{ includeTemplate "dot_config/systemd/user/ollama.service.tmpl" . | sha256sum }}
#
# Without systemd it stops early and exits 0, which chezmoi records as done, so the line below
# carries whether systemd was running: it changes when systemd starts, and the first apply after
# that runs this again (see CLAUDE.md, "systemd on WSL"):
#   systemd {{ if stat "/run/systemd/system" }}running{{ else }}not running{{ end }}
#
# Rendered only on Linux with an NVIDIA driver, and empty otherwise, which chezmoi never runs
# (see lib-local-llm.tmpl). See CLAUDE.md, "Local Model for Claude Code".

set -euo pipefail

prefix="ollama"

# Pinned with the digest upstream publishes in the release's sha256sum.txt. Each release ships one
# archive per accelerator; this is the CUDA one.
version="0.40.3"
archive="ollama-linux-amd64.tar.zst"
checksum="ce6f8b671a699bf1ebafb28d60dbbabf4f37b30b499145fa308a8ba72de021d6"
url="https://github.com/ollama/ollama/releases/download/v${version}/${archive}"

install_root="$HOME/.local/share/ollama"
install_dir="$install_root/$version"
marker="$install_dir/.archive-sha256"
manifest_name=".files.sha256"
link="$HOME/.local/bin/ollama"
unit="ollama.service"
api="http://127.0.0.1:11434"
model={{ $llm.model | quote }}

if [[ "$(uname -m)" != "x86_64" ]]; then
    echo "[$prefix] WARN: no $(uname -m) build is pinned here; Ollama not installed" >&2
    exit 0
fi

# The release counts as installed only when the marker names the pinned archive *and* every file
# still matches the digest recorded when it was unpacked. The marker alone is not enough: a WSL VM
# that went down after an install has left the two largest libraries (libcublasLt, ~500 MB each)
# truncated under a valid marker, and CUDA discovery then died with SIGBUS on every start, which
# Ollama answers by serving from the CPU with nothing but a line in its own log to say so.
release_intact() {
    [[ -x "$install_dir/bin/ollama" ]] &&
        [[ "$(cat "$marker" 2>/dev/null)" == "$checksum" ]] &&
        (cd "$install_dir" && sha256sum --check --status "$manifest_name" 2>/dev/null)
}

install_release() {
    local workdir staging

    if release_intact; then
        echo "[$prefix] Ollama $version is already installed and intact, skipping download" >&2
        return 0
    fi
    if [[ "$(cat "$marker" 2>/dev/null)" == "$checksum" ]]; then
        echo "[$prefix] WARN: the installed Ollama $version no longer matches its digests; reinstalling" >&2
    fi

    if ! command -v zstd >/dev/null 2>&1; then
        echo "[$prefix] ERROR: zstd is required to unpack $archive; the dependency installer provides it" >&2
        return 1
    fi

    workdir="$(mktemp -d)"

    # Downloaded to a file and verified before anything is unpacked. Streaming it into tar, as the
    # upstream installer does, would unpack an HTTP error page or a tampered archive just as readily.
    echo "[$prefix] downloading Ollama $version ($archive)" >&2
    if ! curl --proto '=https' -fsSL "$url" -o "$workdir/$archive"; then
        echo "[$prefix] ERROR: failed to download $url" >&2
        rm -rf "$workdir"
        return 1
    fi

    if ! echo "$checksum  $workdir/$archive" | sha256sum --check --status; then
        echo "[$prefix] ERROR: checksum mismatch for $archive; refusing to install" >&2
        rm -rf "$workdir"
        return 1
    fi

    # Unpacked beside the target and renamed into place, so an interrupted run never leaves a
    # half-populated version directory behind for the gate above to judge.
    staging="$install_root/.staging-$version"
    rm -rf "$staging"
    mkdir -p "$staging"
    if ! zstd -dc "$workdir/$archive" | tar -xf - -C "$staging"; then
        echo "[$prefix] ERROR: failed to unpack $archive" >&2
        rm -rf "$workdir" "$staging"
        return 1
    fi
    rm -rf "$workdir"

    if [[ ! -x "$staging/bin/ollama" ]]; then
        echo "[$prefix] ERROR: $archive has no bin/ollama; refusing to install" >&2
        rm -rf "$staging"
        return 1
    fi

    # Record what was unpacked, then flush it to disk before the marker declares it complete: the
    # marker is the commit record, so it must never reach the disk ahead of the data it vouches for.
    (cd "$staging" && find . -type f ! -name "$manifest_name" -print0 | sort -z | xargs -0 sha256sum > "$manifest_name")
    sync -f "$staging/$manifest_name"

    rm -rf "$install_dir"
    mv "$staging" "$install_dir"
    echo "$checksum" > "$marker"
    sync -f "$marker"
    echo "[$prefix] installed Ollama $version to $install_dir" >&2
}

# Proves the server discovered a usable GPU, without loading anything. While it starts, the server
# logs one "inference compute" line per backend it found, and `library=cpu` alone means no
# accelerator answered. Reading that line replaces the old check, which loaded the model and read
# where Ollama placed it: the load put ~17 GB of weights in VRAM at every apply and paid a ~17 s
# cold start that the first real request would otherwise have re-used. The failure it caught is
# caught the same way -- a damaged CUDA install (a WSL VM once went down mid-install, leaving the
# two libcublasLt libraries truncated) makes discovery crash, `cpu` becomes the only backend, and
# every request then runs on the CPU, an order of magnitude slower, without an error.
verify_gpu() {
    local invocation lines gpu_line description available size

    # Only the lines of this start: the journal keeps every earlier one, and a line from before a
    # broken install would pass the check. systemd has reported an invocation id since v232; the
    # timestamp taken just before the restart is the fallback for one that does not.
    invocation="$(systemctl --user show -p InvocationID --value "$unit" 2>/dev/null || true)"
    journal_since_start() {
        if [[ -n "$invocation" ]]; then
            journalctl --user -u "$unit" --no-pager -o cat "_SYSTEMD_INVOCATION_ID=$invocation" 2>/dev/null
        else
            journalctl --user -u "$unit" --no-pager -o cat --since "$started_at" 2>/dev/null
        fi
    }

    # Discovery runs while the server starts, so its line may arrive a couple of seconds after
    # /api/version answers. A line that is not a GPU is then decisive: the CPU backend is listed
    # only when nothing else answered.
    lines=""
    gpu_line=""
    for _ in $(seq 1 30); do
        lines="$(journal_since_start || true)"
        gpu_line="$(sed -n '/msg="inference compute"/{/library=cpu/!p;}' <<<"$lines")"
        gpu_line="${gpu_line%%$'\n'*}"
        if [[ -n "$gpu_line" ]] || grep -q 'msg="inference compute"' <<<"$lines"; then
            break
        fi
        sleep 1
    done

    if [[ -z "$gpu_line" ]]; then
        if grep -q 'msg="inference compute"' <<<"$lines"; then
            echo "[$prefix] ERROR: Ollama found no usable GPU: the only backend its start-up log lists is the CPU; check 'journalctl --user -u $unit' for a GPU discovery failure" >&2
        else
            echo "[$prefix] ERROR: the server logged no GPU discovery after starting; check 'journalctl --user -u $unit'" >&2
        fi
        return 1
    fi

    description="$(sed -n 's/.*description="\([^"]*\)".*/\1/p' <<<"$gpu_line")"
    available="$(sed -n 's/.*available="\([^"]*\)".*/\1/p' <<<"$gpu_line")"
    echo "[$prefix] ${description:-a GPU} is available to the server${available:+ ($available of VRAM free)}; nothing is loaded, so the first request loads the model" >&2

    # With the model no longer loaded to be measured, this is a forecast rather than an
    # observation: the model's blobs against the VRAM the server reported free. When even the
    # weights alone do not fit, the model cannot run fully on the GPU until whatever else holds
    # the VRAM is freed.
    size="$(curl -fsS --max-time 5 "$api/api/tags" 2>/dev/null | jq -r --arg model "$model" \
        '[.models[]? | select(.name == $model)][0] | .size // empty' 2>/dev/null || true)"
    if [[ -n "$available" && -n "$size" ]] &&
        awk -v gib="$available" -v bytes="$size" 'BEGIN { exit !(gib * 1073741824 < bytes) }'; then
        echo "[$prefix] WARN: only $available of VRAM is free, less than $model's weights alone; part of it will run on the CPU until the GPU is freed" >&2
    fi
}

# Each release unpacks to several GB of CUDA libraries, so only the pinned one is kept. It runs
# after the restart below, once the server no longer maps any of the older files.
prune_releases() {
    local dir
    shopt -s nullglob
    for dir in "$install_root"/*/; do
        dir="${dir%/}"
        [[ "$dir" == "$install_dir" ]] && continue
        [[ "$(basename "$dir")" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
        rm -rf "$dir"
        echo "[$prefix] removed the superseded release $(basename "$dir")" >&2
    done
    shopt -u nullglob
}

if command -v nvidia-smi >/dev/null 2>&1; then
    echo "[$prefix] GPU: $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1)" >&2
fi

install_release || exit 1

mkdir -p "$(dirname "$link")"
ln -sfn "$install_dir/bin/ollama" "$link"

# Without systemd the setup waits and exits 0: the systemd line above changes once systemd
# starts, and that runs this again. A user manager out of reach while systemd runs changes no
# line, so it fails instead, which is what makes chezmoi retry it rather than record it as done.
if [[ ! -d /run/systemd/system ]]; then
    echo "[$prefix] WARN: systemd is not running, so $unit cannot start and $model is not pulled yet; the first apply after systemd starts finishes this (on WSL, 'wsl.exe --shutdown' restarts WSL with it)" >&2
    exit 0
fi
if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "[$prefix] ERROR: systemd is running, but this session reaches no systemd user manager; check 'systemctl --user status'" >&2
    exit 1
fi

# A system-wide server left by Ollama's own installer holds the same port, and this one would
# fail to bind behind it.
if systemctl is-active --quiet "$unit" 2>/dev/null; then
    echo "[$prefix] WARN: a system-wide $unit is running and holds port 11434; stop and disable it" >&2
fi

systemctl --user daemon-reload
if ! systemctl --user enable "$unit" >/dev/null 2>&1; then
    echo "[$prefix] ERROR: could not enable the user unit $unit" >&2
    exit 1
fi

# Restart rather than start: a running server keeps the binary and the settings it was started
# with, and this script runs precisely when one of those changed. The time is recorded first so
# the GPU check can read this start's log where systemd reports no invocation id.
started_at="$(date '+%Y-%m-%d %H:%M:%S')"
systemctl --user restart "$unit"

ready=false
for _ in $(seq 1 30); do
    if curl -fsS --max-time 2 "$api/api/version" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done
if [[ "$ready" != true ]]; then
    echo "[$prefix] ERROR: the server did not answer at $api; check 'journalctl --user -u $unit'" >&2
    exit 1
fi

# Before the pull, so a machine whose GPU discovery broke fails here instead of after an 18 GB
# download. Nothing is loaded by it: the model stays out of VRAM until a request needs it.
verify_gpu || exit 1

prune_releases

if "$link" show "$model" >/dev/null 2>&1; then
    echo "[$prefix] $model is already pulled" >&2
else
    echo "[$prefix] pulling $model; the first pull is a download of many GB" >&2
    if ! "$link" pull "$model"; then
        echo "[$prefix] ERROR: failed to pull $model" >&2
        exit 1
    fi
fi

echo "[$prefix] ready at $api with $model; the model loads on the first request that needs it" >&2
{{- end }}
