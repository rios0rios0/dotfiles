{{- $wsl := contains "microsoft" (.chezmoi.kernel | toString) -}}
#!/bin/bash

# Removes dependencies that this repository used to install on Linux (baremetal/WSL)
# but no longer declares in run_once_before_linux-002-install-dependencies.sh.tmpl.
#
# This is a `run_onchange_` script: chezmoi re-runs it whenever the tombstone list
# below changes, and every handler is idempotent, so it is a silent no-op once a
# machine is clean. See `.docs/dependency-lifecycle.md` for why this exists.

set -euo pipefail

{{ template "lib-remove-dependencies.sh" }}

# Format: "<strategy>:<target>" -- strategies are defined in the library above.
# Add one group per removal, newest first, and reference the pull request that
# dropped the installer so the entry can be retired once every machine has
# converged (a commit hash from the feature branch changes when the branch is
# rebased before merge).
TOMBSTONES=(
    # Claude Code's npm package -- replaced in #269 (2026-10-27) by Anthropic's native build,
    # which `install_claude_cli` puts behind ~/.local/bin/claude and which updates itself. npm 12
    # blocks the postinstall that copies the native binary over the package's placeholder, so the
    # npm `claude` would turn into a stub at its next update. The installer runs before this and
    # fails the apply when the native build is missing, so this never removes the only `claude`.
    "npm_global:@anthropic-ai/claude-code"

    # Kali's apt `yq`, kislyuk's Python wrapper around jq (with its `xq` and `tomlq`) -- replaced
    # in #260 (2026-10-27) by mikefarah's yq, which `install_yq` puts in ~/.local/bin. The apt
    # one has no `eval`, so `make lint-syntax` failed on every YAML file. Nothing depends on it.
    "apt:yq"

    # The GitHub Copilot, Codex and official OpenCode CLIs, and claude-omni -- removed in #260
    # (2026-10-27). ocode, the fork build, replaces `opencode`, and ~/.opencode held nothing
    # but its binary and the `opencode2` shim. The Copilot installer extracted one binary into
    # ~/.local/bin. ~/.claude-omni was claude-omni's profile: its transcripts, task audits,
    # GPU locks and saved /model choice. ~/.codex and ~/.copilot are deliberately NOT listed:
    # they hold logins and history, and aisync may still sync rules into them.
    "npm_global:@openai/codex"
    "path:$HOME/.local/bin/copilot"
    "path:$HOME/.opencode"
    "path:$HOME/.claude-omni"
{{ if $wsl }}
    # Tailscale's Linux client, on WSL only: Windows' client replaced it in #229, and
    # Tailscale's WSL guide says a client inside WSL breaks WSL's traffic through the
    # Windows one. Bare metal keeps tailscaled. Root owns what this leaves behind --
    # the apt source and its keyring, and /var/lib/tailscale, which a purge removes:
    #   sudo apt-get purge -y tailscale
    #   sudo rm -f /etc/apt/sources.list.d/tailscale.list /usr/share/keyrings/tailscale-archive-keyring.gpg
    "apt:tailscale"
{{ end }}
    # OCI CLI installed from Oracle's own install.sh, superseded by the pipx route
    # in this repository's `install_oci_cli`. The venv is ~750 MB of dead weight
    # once pipx owns `~/.local/bin/oci`, and the launcher it left there was what
    # stopped pipx claiming that name in the first place. `~/.oci` is deliberately
    # NOT listed: it holds the user's tenancy config and API keys, not the CLI.
    "path:$HOME/.local/lib/oracle-cli"
    "path:$HOME/.local/bin/oci-cli-scripts"

    # Gemini CLI and Cursor CLI -- removed in 601cbeb (2026-07-21)
    "npm_global:@google/gemini-cli"
    "path:$HOME/.local/bin/cursor-agent"
    "path:$HOME/.local/share/cursor-agent"
)

apply_tombstones "${TOMBSTONES[@]}"
