#!/bin/bash

# Writes ~/AGENTS.md, the agent guide for this machine, from .chezmoitemplates/home-agents.md
# through .chezmoitemplates/lib-home-agents.sh, which Android shares. It is not the repository's
# AGENTS.md, which .chezmoiignore keeps out of the home folder: see "The Home AGENTS.md" there.
#
# `run_onchange_`: the guide below is part of this script, so the script runs again exactly when the
# guide changes, and a `chezmoi diff` shows the guide only then.

set -euo pipefail

{{ template "lib-home-agents.sh" }}
write_home_agents <<'HOME_AGENTS_MD'
{{ includeTemplate "home-agents.md" . | trim }}
HOME_AGENTS_MD
