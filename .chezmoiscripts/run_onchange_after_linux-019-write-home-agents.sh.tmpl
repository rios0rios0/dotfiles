#!/bin/bash

# Writes the agent guide for this machine, from .chezmoitemplates/home-agents.md, to ~/AGENTS.md for
# OpenCode and to ~/CLAUDE.md for Claude Code, through .chezmoitemplates/lib-home-agents.sh, which
# Android shares. Neither is the repository's own file of that name, which .chezmoiignore keeps out
# of the home folder: see "The Home AGENTS.md" in AGENTS.md.
#
# `run_onchange_`: the guide below is part of this script, so the script runs again exactly when the
# guide changes, and a `chezmoi diff` shows the guide only then.

set -euo pipefail

{{ template "lib-home-agents.sh" }}
write_home_agents <<'HOME_AGENTS_MD'
{{ includeTemplate "home-agents.md" . | trim }}
HOME_AGENTS_MD
