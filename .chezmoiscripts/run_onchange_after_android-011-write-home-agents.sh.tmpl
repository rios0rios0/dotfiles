#!/data/data/com.termux/files/usr/bin/bash

# Writes the agent guide for this phone to ~/AGENTS.md and ~/CLAUDE.md, as
# run_onchange_after_linux-019 does on Linux and with the same body
# (.chezmoitemplates/lib-home-agents.sh); the guide itself is rendered for Termux. See "The Home
# AGENTS.md" in AGENTS.md.

set -euo pipefail

{{ template "lib-home-agents.sh" }}
write_home_agents <<'HOME_AGENTS_MD'
{{ includeTemplate "home-agents.md" . | trim }}
HOME_AGENTS_MD
