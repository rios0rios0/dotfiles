{{- /*
  Stops `chezmoi apply` before anything runs when the config file lacks data the
  templates read. Only `chezmoi init` renders ~/.config/chezmoi/chezmoi.yaml from
  .chezmoi.yaml.tmpl, so a machine initialised before a data key existed keeps a
  config without it. chezmoi does print "config file template has changed, run
  chezmoi init" at the top of every apply, but on Windows that line scrolled away
  under the winget pass, and the apply then died at dot_gitconfig.tmpl with only
  `map has no entry for key "deviceName"`. `chezmoi apply --force` silences that
  warning without regenerating the config; this check is not fooled by it.

  The same goes for a Windows config that does not run op.exe with OP_ACCOUNT set:
  one from before OP_ACCOUNT dies at its first 1Password template with "cannot
  connect to 1Password app, make sure it is running", which points at the app
  rather than at the config, and one that runs the op-retry.cmd shim asks for an
  approval for every item (see "1Password CLI Retry" in AGENTS.md).

  It renders to nothing when the config is current, so chezmoi never runs it, and
  its name sorts before every platform's installers. Add each new data key from
  .chezmoi.yaml.tmpl to the list below.
*/ -}}
{{- range list "deviceName" -}}
{{-   if not (hasKey $ .) -}}
{{-     fail (printf "[chezmoi-config] ERROR: the chezmoi config has no %q because it was generated from an older .chezmoi.yaml.tmpl; run `chezmoi init` to regenerate it, then apply again" .) -}}
{{-   end -}}
{{- end -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $command := toString .chezmoi.config.onepassword.command -}}
{{- /* env is a map only when the config sets it; `get` reads a missing key as "". */ -}}
{{-   $opAccount := "" -}}
{{-   with .chezmoi.config.env -}}
{{-     $opAccount = toString (get . "OP_ACCOUNT") -}}
{{-   end -}}
{{-   if or (hasSuffix "op-retry.cmd" $command) (eq $opAccount "") -}}
{{-     fail (printf "[chezmoi-config] ERROR: the chezmoi config runs 1Password's CLI as %q, not as op.exe with OP_ACCOUNT set, because it was generated from an older .chezmoi.yaml.tmpl; run `chezmoi init` to regenerate it, then apply again" $command) -}}
{{-   end -}}
{{- end -}}
