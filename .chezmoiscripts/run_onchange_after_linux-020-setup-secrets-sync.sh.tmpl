#!/bin/bash

# Enables the hourly sync of the home-secrets folders as a systemd user timer.
#
# `run_onchange_` rather than `run_once_`: the digest lines below change whenever the service, the
# timer or the sync script changes, and the systemd line when systemd starts, so any of those re-runs
# this script, which reloads systemd and restarts the timer. The units deploy verbatim, so their
# digests are of the files; the script is a template -- its device, tools and hub come from
# .chezmoidata/secrets-sync.yaml, its shared half from lib-secrets-backup.sh -- so its digest is of
# what it renders to, and editing either re-runs this too:
#   service {{ include "dot_config/systemd/user/secrets-sync.service" | sha256sum }}
#   timer {{ include "dot_config/systemd/user/secrets-sync.timer" | sha256sum }}
#   script {{ includeTemplate "dot_local/bin/executable_secrets-sync.tmpl" . | sha256sum }}
#   systemd {{ if stat "/run/systemd/system" }}running{{ else }}not running{{ end }}
#
# Without systemd it stops early and exits 0, which chezmoi records as done; the systemd line
# changing runs it again on the first apply after systemd starts (see CLAUDE.md, "systemd on WSL").
#
# The sync encrypts to the home-secrets backup key and authenticates with it: the same folders, the
# same devices and the same OneDrive as the backups. run_before_linux-005 fetches it from 1Password
# before this runs.

set -euo pipefail

prefix="secrets-sync"
unit="secrets-sync.timer"
identity="$HOME/.ssh/secrets-backup-key"
hub={{ .secretsSync.hub | squote }}

{{ includeTemplate "lib-secrets-backup.sh" }}

# The hub is the personal OneDrive, reachable from WSL alone, and the unit files are not deployed
# elsewhere (see .chezmoiignore), so there is nothing to enable off WSL.
if ! grep -qiE "(microsoft|wsl)" /proc/version 2>/dev/null; then
    exit 0
fi

if [[ ! -d /run/systemd/system ]]; then
    echo "[$prefix] WARN: systemd is not running, so $unit cannot be enabled yet; the first apply after systemd starts finishes this (on WSL, 'wsl.exe --shutdown' restarts WSL with it)" >&2
    exit 0
fi
if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "[$prefix] ERROR: systemd is running, but this session reaches no systemd user manager; check 'systemctl --user status'" >&2
    exit 1
fi

if [[ ! -f "$identity" ]]; then
    echo "[$prefix] WARN: $identity is missing, so the timer will start a sync that fails until it exists;" >&2
    echo "[$prefix] WARN: the next apply fetches it from 1Password ({{ .ageKeys.secretsBackup.privateKey }}) -- never generate a new one" >&2
fi

systemctl --user daemon-reload
if ! systemctl --user enable "$unit" >/dev/null 2>&1; then
    echo "[$prefix] ERROR: could not enable the user unit $unit" >&2
    exit 1
fi

# Start rather than restart: enabling a stopped timer is the common case, and restarting a running
# one would only reset its pending run.
systemctl --user start "$unit"

echo "[$prefix] enabled $unit; it syncs the home-secrets folders hourly, see 'systemctl --user list-timers secrets-sync.timer'" >&2

# Where the snapshots meet, resolved here too, so a missing personal OneDrive shows at the apply
# that enables the timer rather than as a failed unit an hour later.
if [[ -z "$hub" ]]; then
    echo "[$prefix] WARN: no hub is configured (secretsSync.hub), so nothing is synced" >&2
elif secrets_mirror_resolve "$hub" "Backup/sync" "secretsSync.hub"; then
    echo "[$prefix] the devices' snapshots meet in $SECRETS_MIRROR_ROOT/<tool>/, this one's as {{ .deviceName }}.tar.age" >&2
else
    echo "[$prefix] WARN: nothing syncs until this is fixed: $SECRETS_MIRROR_ERROR" >&2
fi
