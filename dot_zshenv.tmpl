# ~/.zshenv: sourced for ALL zsh invocations (interactive, non-interactive, login, non-login)
# This file sets up PATH for tools that need to be available in all shell contexts,
# including non-interactive shells spawned by IDEs like VSCode, JetBrains, etc.

# Avoid running this file multiple times in the SAME shell process
# Using $$ (current PID) ensures new shell processes still get initialized
[[ "$__ZSHENV_SOURCED_PID" == "$$" ]] && return
export __ZSHENV_SOURCED_PID="$$"

###### Non-interactive Shell Defaults ####################################################################################
# zsh aborts a whole command line when a glob matches nothing (`nomatch`), which is useful at a
# prompt and hostile in scripts: `grep -n FOO $PREFIX/etc/profile.d/* ~/.zshrc` never runs the grep
# at all when the directory is empty. The shells that hit it are the ones driven non-interactively
# -- Claude Code's Bash tool, IDE terminals, `zsh -c` from scripts -- so the option is relaxed only
# there, and an interactive shell keeps the prompt-time error.
[[ -o interactive ]] || setopt NO_NOMATCH

###### Termux TMPDIR Fix #################################################################################################
# On Termux/Android, /tmp is owned by shell:shell (0771) and not writable by app processes.
# TMPDIR must be set before any tool (Node.js, Claude Code, etc.) calls os.tmpdir(),
# which defaults to /tmp on Linux when TMPDIR is unset.
if [[ -n "$PREFIX" && -d "$PREFIX/tmp" ]]; then
    export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
fi

{{- if eq .chezmoi.os "android" }}

###### Android Performance Tuning ######################################################################################
# These environment variables optimize Node.js and memory allocation for heavy workloads on Termux.
# Gated by a chezmoi template conditional rather than a runtime `$PREFIX` test: `PREFIX` is a
# conventional autotools/make variable that users legitimately export on desktop Linux, and
# `DBUS_SESSION_BUS_ADDRESS=disabled:` would break real session-bus clients (keyring, notifications)
# in such a shell. A `-d "$PREFIX/tmp"` test only narrows that window — `PREFIX=/usr` still passes
# wherever the legacy `/usr/tmp` symlink exists. chezmoi resolves the platform at render time, so on
# non-Android machines this block is absent from `~/.zshenv` entirely and no runtime guard is needed.
# Node.js libuv thread pool: default is 4, bottleneck for I/O-heavy tools like Claude Code
export UV_THREADPOOL_SIZE=16
# Reduce glibc memory arena count to limit fragmentation on mobile
export MALLOC_ARENA_MAX=2
# Block D-Bus session autolaunch. With this unset, tools run through termux-etc-seccomp
# (op, gh, acli, claude) start a `dbus-daemon --session --fork` that reparents to PID 1
# and is never reaped. They accumulate across days (19 observed from 3 days of use) and
# consume Android's ~32-process phantom limit; once it is reached the phantom process
# killer SIGKILLs Termux with no memory pressure at all. Every leaked daemon carried
# `_=termux-etc-seccomp`, and three appeared in the same second as an `op` invocation,
# so `op` is the likeliest source — but the guard is set for the whole Termux env
# because any wrapped tool can trigger it. `disabled:` is an unroutable address: both
# libdbus and Go's godbus return a connection error rather than falling back to
# autolaunch. Nothing here needs a session bus.
export DBUS_SESSION_BUS_ADDRESS=disabled:

# Restore the LD_PRELOAD shims parked by the Claude wrapper and termux-etc-mount. Termux
# exports LD_PRELOAD so termux-exec can rewrite `#!/usr/bin/env` and `#!/bin/sh` shebangs on
# execve, and it is how termux-etc-redirect's Tier 1 is enabled -- but a musl loader treats a
# bionic entry it cannot relocate as fatal, so the value is moved to TERMUX_ETC_LD_PRELOAD
# before the musl Claude binary starts. Every shell spawned for a tool call sources this file,
# which makes it the place that hands the shims back to bionic descendants: without them
# `make lint` and every `#!/usr/bin/env` pipelines script fail with exit 127 under Claude
# while working from a plain Termux tab.
#
# An export from inside a running shell reaches only its children, never the shell itself, so
# a `#!/usr/bin/env node` script exec'd straight from a tool call -- any npm-installed CLI --
# needs the library mapped before zsh starts. For Claude Code that is ~/.local/bin/claude-zsh,
# the CLAUDE_CODE_SHELL launcher the `claude` wrapper exports (both written by
# run_once_before_android-001e), which restores the value and execs zsh; by the time this
# block runs in such a shell LD_PRELOAD is already set and it does nothing. Codex reaches its
# tool shells a third way, which never touches this file: they are `bash -lc` (it resolves the
# shell from the password database, never from $SHELL), so the `codex` wrapper puts the value
# straight into their environment with `-c shell_environment_policy.set.LD_PRELOAD=...`. This
# block stays for everything else that parks the variable: a termux-etc-mount run by hand, an
# SSH login, an older wrapper.
if [[ -z "$LD_PRELOAD" && -n "$TERMUX_ETC_LD_PRELOAD" ]]; then
    export LD_PRELOAD="$TERMUX_ETC_LD_PRELOAD"
elif [[ -z "$LD_PRELOAD" && -r "$PREFIX/lib/libtermux-exec.so" ]]; then
    # Nothing was parked either -- a wrapper that still unsets the variable, or an SSH login
    # that never had it. termux-exec alone is what the shebang rewriting needs.
    export LD_PRELOAD="$PREFIX/lib/libtermux-exec.so"
fi

# Having LD_PRELOAD back -- from claude-zsh, or from the block above -- re-breaks the one
# thing that runs the musl binary from inside this shell. Claude Code appends its own `grep`
# and `find` functions to the shell snapshot it sources into every tool call, and both run
# the Claude Code binary itself under another argv[0] -- `ARGV0=ugrep "$CLAUDE_CODE_EXECPATH"
# ...`, `ARGV0=bfs ...` -- because that binary is multi-call and dispatches on argv[0] alone.
# $CLAUDE_CODE_EXECPATH points at the musl build, so with LD_PRELOAD back every grep and find
# in a tool call exits 127 with eleven "symbol not found" lines from the loader. The
# functions are appended after this file is sourced, so redefining grep/find here cannot
# win; the only lever left is the path they exec, which is why $CLAUDE_CODE_EXECPATH is
# repointed at a shim that drops LD_PRELOAD for that one exec and keeps argv[0] (a "#!"
# wrapper cannot -- the kernel replaces argv[0] with the interpreter path -- hence the small
# C program built by .chezmoiscripts/run_after_android-007-build-claude-exec-shim.sh).
#
# The guards keep this idempotent: a shell nested under a tool call inherits the repointed
# value and must not park the shim as its own target, and when Claude Code updates itself the
# parent exports the new version's path, so the next tool call repoints afresh. With the shim
# missing (an apply that has not built it yet) nothing is repointed and the behaviour is
# exactly what it was before it existed.
_claudeExecShim="$HOME/.local/bin/claude-exec-shim"
if [[ -x "$_claudeExecShim" && -x "$CLAUDE_CODE_EXECPATH" && "$CLAUDE_CODE_EXECPATH" != "$_claudeExecShim" ]]; then
    export TERMUX_CLAUDE_EXEC_TARGET="$CLAUDE_CODE_EXECPATH"
    export CLAUDE_CODE_EXECPATH="$_claudeExecShim"
fi
unset _claudeExecShim
{{- end }}

###### Essential PATH Setup ##############################################################################################
# Local bin directory
if [[ -d "$HOME/.local/bin" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

{{- if ne .chezmoi.os "android" }}
# Fly.io CLI (`flyctl`, plus its `fly` alias): the upstream installer puts it under ~/.fly and
# would otherwise append this export to the rc files chezmoi owns (`install_fly_cli` runs it
# with `--non-interactive` and no `--setup-path` for that reason). Deliberately NOT on Android:
# there the static binary must be reached through the termux-etc-seccomp wrappers that
# `run_after_android-003-wrap-terra-clis.sh` writes into ~/.local/bin, and ~/.fly/bin ahead of
# them on PATH would hand every call to the unwrapped binary, which cannot resolve DNS.
if [[ -d "$HOME/.fly/bin" ]]; then
    export PATH="$HOME/.fly/bin:$PATH"
fi
{{- end }}

###### Version Managers PATH Setup #######################################################################################
# These only add paths - full initialization happens in .zshrc for interactive shells

# SDKMAN - Java ecosystem (java, gradle, maven, etc.)
# SDKMAN uses "current" symlinks for active versions
sdkmanRoot="$HOME/.sdkman"
if [[ -d "$sdkmanRoot/candidates" ]]; then
    export SDKMAN_DIR="$sdkmanRoot"
    for candidate in "$sdkmanRoot/candidates"/*/; do
        if [[ -d "${candidate}current/bin" ]]; then
            export PATH="${candidate}current/bin:$PATH"
        fi
    done
fi

# NVM - Node.js version manager
# Resolve the default alias to the Node version NVM itself would select.
#
# "Latest installed" is NOT that version. NVM's aliases form a chain --
# `default` -> `lts/*` -> `lts/<codename>` -> `vX.Y.Z` -- and a machine that ever
# installed a non-LTS Current release keeps it in `versions/node`, where a
# version sort ranks it above the LTS the chain points at. That is not a
# cosmetic difference: `npm install -g` writes into the *active* version's tree,
# so the dependency installer (which runs the real `nvm`) puts `codex`, `sentry`
# and Claude Code under the LTS, while a shell that picked the higher Current
# release sees none of them and reports every one of those CLIs as missing.
nvmRoot="$HOME/.nvm"
if [[ -d "$nvmRoot" ]]; then
    export NVM_DIR="$nvmRoot"
    nvmNodeBin=""
    nvmVersion=""
    if [[ -f "$nvmRoot/alias/default" ]]; then
        nvmVersion=$(command cat "$nvmRoot/alias/default" 2>/dev/null)
        # Follow the chain until it lands on a concrete version. The hop budget
        # is a cycle guard: NVM will happily store `alias a b` and `alias b a`.
        nvmHops=0
        while [[ -n "$nvmVersion" && "$nvmVersion" != "system" \
            && ! "$nvmVersion" =~ ^v?[0-9] && "$nvmHops" -lt 10 ]]; do
            if [[ -f "$nvmRoot/alias/$nvmVersion" ]]; then
                nvmVersion=$(command cat "$nvmRoot/alias/$nvmVersion" 2>/dev/null)
                nvmHops=$((nvmHops + 1))
            else
                nvmVersion=""
            fi
        done
        # `default -> system` deliberately means "no NVM Node on PATH", so leave
        # PATH alone instead of falling back to an installed version.
        if [[ "$nvmVersion" == "system" ]]; then
            nvmVersion=""
            nvmNodeBin="system"
        elif [[ -n "$nvmVersion" ]]; then
            nvmVersion="v${nvmVersion#v}"
            nvmNodeBin="$nvmRoot/versions/node/$nvmVersion/bin"
            # A partial alias (`nvm alias default 22`) is a valid NVM version spec
            # that resolves to the newest installed match, not to a directory named
            # `v22`. Without this the constructed path fails the check below and the
            # fallback hands back an unrelated newest version -- the same mismatch
            # between what NVM picks and what the shell picks that this block exists
            # to prevent. Anchoring on `.` keeps `v2` off `v20.x`.
            if [[ ! -d "$nvmNodeBin" ]]; then
                nvmMatch=$(command ls -1 "$nvmRoot/versions/node" 2>/dev/null \
                    | command grep -E "^${nvmVersion}(\.|\$)" | sort -V | tail -1)
                if [[ -n "$nvmMatch" ]]; then
                    nvmNodeBin="$nvmRoot/versions/node/$nvmMatch/bin"
                fi
            fi
        fi
    fi
    # Fallback: no alias, a dangling chain, or an alias naming a version that is
    # no longer installed -- use the newest installed version so the shell still
    # has a Node.
    if [[ "$nvmNodeBin" != "system" && ( -z "$nvmNodeBin" || ! -d "$nvmNodeBin" ) ]]; then
        latestNode=$(command ls -1 "$nvmRoot/versions/node" 2>/dev/null | sort -V | tail -1)
        if [[ -n "$latestNode" ]]; then
            nvmNodeBin="$nvmRoot/versions/node/$latestNode/bin"
        fi
    fi
    if [[ "$nvmNodeBin" != "system" && -d "$nvmNodeBin" ]]; then
        export PATH="$nvmNodeBin:$PATH"
    fi
fi

{{- if ne .chezmoi.os "android" }}
# GVM - Go version manager
gvmRoot="$HOME/.gvm"
if [[ -d "$gvmRoot" ]]; then
    export GVM_ROOT="$gvmRoot"
    # Pick the latest installed Go version that has a valid bin/ directory.
    # Empty directories (e.g., from Go's toolchain auto-download) are skipped.
    # Non-interactive shells just need the newest Go binary in PATH — Go's
    # toolchain directive in go.mod handles per-project version selection.
    gvmGoVersion=""
    for _v in $(command ls -1 "$gvmRoot/gos" 2>/dev/null | command grep -v '^system$' | sort -V); do
        if [[ -d "$gvmRoot/gos/$_v/bin" ]]; then
            gvmGoVersion="$_v"
        fi
    done
    unset _v
    # Set up Go paths if we found a valid version.
    # IMPORTANT: Do NOT export GOROOT. Go auto-detects it from the binary location.
    # Exporting GOROOT breaks Go's toolchain auto-download: when go.mod requires a
    # newer version (e.g., go1.26.1), Go downloads and re-execs the new binary, but
    # the inherited GOROOT still points to the old version's stdlib, causing:
    #   compile: version "go1.25.5" does not match go tool version "go1.26.1"
    if [[ -n "$gvmGoVersion" ]]; then
        export PATH="$gvmRoot/gos/$gvmGoVersion/bin:$PATH"
        # Add GVM pkgsets paths (where "go install" binaries live under GVM)
        gvmPkgset="$gvmRoot/pkgsets/$gvmGoVersion/global"
        if [[ -d "$gvmPkgset" ]]; then
            export GOPATH="$gvmPkgset"
            export PATH="$gvmPkgset/bin:$gvmPkgset/overlay/bin:$PATH"
        fi
    fi
    # Also add the GVM bin directory
    if [[ -d "$gvmRoot/bin" ]]; then
        export PATH="$gvmRoot/bin:$PATH"
    fi
fi

# Go workspace bin (for go install'd binaries outside of GVM)
if [[ -z "$GOPATH" && -d "$HOME/go/bin" ]]; then
    export GOPATH="$HOME/go"
    export PATH="$HOME/go/bin:$PATH"
fi
{{- end }}

# Pin the Go module cache to $HOME instead of letting Go derive it from
# whatever GOPATH happens to be set.
#
# Go defaults GOMODCACHE to "$GOPATH/pkg/mod", so any script that repoints
# GOPATH drags the module cache along with it. The pipelines Go scripts do
# exactly that -- `GOPATH="$(pwd)/.go"` when GOPATH is unset -- which puts the
# cache wherever the caller happened to be standing. Run one from a directory
# inside $TMPDIR (Claude Code scratchpads live at $TMPDIR/claude-<pid>/...) and
# the cache is created there.
#
# That is fatal on Android. Go writes module entries as 0400 files inside 0500
# directories, and unlinking a child needs its *parent* writable, so nothing can
# delete them without a chmod first. Termux's TermuxService.onDestroy() calls
# clearTermuxTMPDIR(), which collects one stack trace per entry it fails to
# remove and then stringifies the batch -- ~16k undeletable entries produced a
# 98 MB string against a 256 MB heap limit and Termux died with an
# OutOfMemoryError every time it was closed.
#
# Pinning is safe: the module cache is content-addressed and immutable, so
# sharing one across GOPATHs and GVM pkgsets is the intended arrangement (it is
# why GOMODCACHE was split out of GOPATH in Go 1.15). Pkgset isolation still
# applies to bin/, which is what it is actually for.
export GOMODCACHE="$HOME/go/pkg/mod"

# Pyenv - Python version manager
pyenvRoot="$HOME/.pyenv"
if [[ -d "$pyenvRoot" ]]; then
    export PYENV_ROOT="$pyenvRoot"
    # Add pyenv bin directory
    if [[ -d "$PYENV_ROOT/bin" ]]; then
        export PATH="$PYENV_ROOT/bin:$PATH"
    fi
    # Add pyenv shims (this is how pyenv intercepts python commands)
    if [[ -d "$PYENV_ROOT/shims" ]]; then
        export PATH="$PYENV_ROOT/shims:$PATH"
    fi
fi

# Cargo/Rust
if [[ -d "$HOME/.cargo/bin" ]]; then
    export CARGO_HOME="$HOME/.cargo"
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# Krew (kubectl plugin manager)
if [[ -d "$HOME/.krew/bin" ]]; then
    export PATH="$HOME/.krew/bin:$PATH"
fi

# Android SDK
if [[ -d "$HOME/Android/Sdk" ]]; then
    export ANDROID_SDK_ROOT="$HOME/Android/Sdk"
    if [[ -d "$ANDROID_SDK_ROOT/emulator" ]]; then
        export PATH="$ANDROID_SDK_ROOT/emulator:$PATH"
    fi
    if [[ -d "$ANDROID_SDK_ROOT/platform-tools" ]]; then
        export PATH="$ANDROID_SDK_ROOT/platform-tools:$PATH"
    fi
fi

# Yarn global binaries
if [[ -d "$HOME/.yarn/bin" ]]; then
    export PATH="$HOME/.yarn/bin:$PATH"
fi

###### Cached 1Password Credentials & Workspaces ###############################################################
# Written by shell-credentials.sh and workspace-aliases.sh in interactive shells, auto-deleted after 24h.
# Provides env vars and aliases to non-interactive shells (MCPs, IDE subshells).
#
# Each cache also records which names 1Password returned, in $_OP_CRED_NAMES and
# $_OP_WS_NAMES. Those manifests travel with the environment, so a credential
# deleted from the vault — which merely stops appearing in the cache — can still
# be recognised as stale here. Without this, an exported credential survives in
# every shell forked from one that loaded it before the deletion (tmux panes, IDE
# terminals, MCP subshells), and no new terminal ever drops it.
_op_cred_inherited="${_OP_CRED_NAMES-}"
_op_ws_inherited="${_OP_WS_NAMES-}"

for _cache_file in "$HOME/.cache/op-credentials.env" "$HOME/.cache/op-workspaces.env"; do
    if [[ -f "$_cache_file" ]]; then
        _mtime=$(stat -c %Y "$_cache_file" 2>/dev/null)
        _now=$(date +%s)
        if (( _now - _mtime > 86400 )); then
            rm -f "$_cache_file"  # expired → delete
        else
            source "$_cache_file"  # valid → load
        fi
        unset _mtime _now
    fi
done
unset _cache_file

# Only a cache that was actually loaded can prove a name is gone, so an expired or
# missing cache leaves the manifests untouched and prunes nothing. Guarding on a
# changed manifest also keeps the common cases free: a terminal that inherits
# nothing, and a subshell whose parent is already up to date, never load the helper.
if [[ -n "$_op_cred_inherited$_op_ws_inherited" ]] \
    && [[ "$_op_cred_inherited" != "${_OP_CRED_NAMES-}" || "$_op_ws_inherited" != "${_OP_WS_NAMES-}" ]] \
    && [[ -r "$HOME/.scripts/linux-engineering-op-loader.sh" ]]; then
    source "$HOME/.scripts/linux-engineering-op-loader.sh"
    _op_prune_removed "credentials" "$_op_cred_inherited" "${_OP_CRED_NAMES-}" _op_forget_variable
    _op_prune_removed "workspaces" "$_op_ws_inherited" "${_OP_WS_NAMES-}" _op_forget_alias
fi
unset _op_cred_inherited _op_ws_inherited
