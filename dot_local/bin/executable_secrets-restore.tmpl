#!/bin/bash

# Restores the home-secrets folders from an archive secrets-backup wrote -- on this machine, or on
# another one and found in the mirror (--device) -- on a machine that has nothing but the backup
# key. It is the counterpart to secrets-backup; see CLAUDE.md, "Home-Secrets Backups", and
# .docs/secrets-backup.md.
#
# Nothing is written until the archive has passed its checks. age hides an archive's content but
# proves nothing about who wrote it -- the recipient is public, in .chezmoidata/age-keys.yaml -- so
# every entry must belong to one of the configured sources and escape nothing (no absolute path, no
# `..`), or the whole archive is refused. A source whose folder already exists is left alone unless
# --force is given, so a restore never silently clobbers live state; files come back with the
# permissions they had (a ~/.kube/config stays mode 600).

set -euo pipefail
umask 077

prefix="secrets-restore"
default_device={{ .deviceName | squote }}
default_mirror={{ .secretsBackup.mirror | squote }}
default_sources={{ .secretsBackup.sources | join " " | squote }}

restore_root="${SECRETS_RESTORE_ROOT:-$HOME}"
backup_dir="${SECRETS_BACKUP_DIR:-$HOME/.local/share/secrets-backups}"
identity="${SECRETS_BACKUP_IDENTITY:-$HOME/.ssh/secrets-backup-key}"
mirror="${SECRETS_BACKUP_MIRROR-$default_mirror}"
sources_override="${SECRETS_BACKUP_SOURCES:-}"

{{ includeTemplate "lib-secrets-backup.sh" }}

log() { echo "[$prefix] $*" >&2; }
warn() { echo "[$prefix] WARN: $*" >&2; }
fail() { echo "[$prefix] ERROR: $*" >&2; exit 1; }

usage() {
    cat >&2 <<EOF
Usage: secrets-restore [options] [ARCHIVE]

Restores the home-secrets folders from a secrets-backup archive: ARCHIVE, or the newest archive
of this device ($default_device) or of --device's, from $backup_dir and the mirror, into
$restore_root.

  --list         list the archives found, newest first, and exit
  --device NAME  read NAME's folder in the mirror instead of this device's
  --force        overwrite a source whose folder already exists (default: skip it)
  --yes          restore without asking; required without a terminal

Environment overrides: SECRETS_RESTORE_ROOT (default: \$HOME), SECRETS_BACKUP_DIR,
SECRETS_BACKUP_IDENTITY, SECRETS_BACKUP_MIRROR, SECRETS_BACKUP_SOURCES.
EOF
}

list=false
force=false
yes=false
device="$default_device"
archive=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --list) list=true ;;
        --device)
            [[ $# -ge 2 ]] || fail "--device needs a device name; see --help"
            device="$2"
            shift
            ;;
        --device=*) device="${1#*=}" ;;
        --force) force=true ;;
        --yes|-y) yes=true ;;
        -*) fail "unexpected option '$1'; see --help" ;;
        *)
            [[ -z "$archive" ]] || fail "more than one archive given; see --help"
            archive="$1"
            ;;
    esac
    shift
done
[[ "$device" =~ ^[A-Za-z0-9._-]+$ ]] || fail "'$device' is not a device name"

read -ra sources <<<"${sources_override:-$default_sources}"
[[ ${#sources[@]} -gt 0 ]] || fail "no sources configured"

# Where the device's archives are: this machine's backup folder when the device is this one, then
# the device's folder in the mirror, when the mirror can be reached.
folders=()
if [[ "$device" == "$default_device" ]]; then
    folders+=("$backup_dir")
fi
mirror_problem=""
if secrets_mirror_resolve "$mirror"; then
    folders+=("$SECRETS_MIRROR_ROOT/$device")
else
    mirror_problem="$SECRETS_MIRROR_ERROR"
fi

if $list; then
    [[ -z "$mirror_problem" ]] || warn "the mirror is not read: $mirror_problem"
    mapfile -t found < <(secrets_list_archives "${folders[@]}")
    [[ ${#found[@]} -gt 0 ]] || fail "no archive of $device in: ${folders[*]:-nowhere}"
    for path in "${found[@]}"; do
        printf '%s\t%s\n' "$(du -h -- "$path" | cut -f1)" "$path"
    done
    exit 0
fi

command -v age >/dev/null 2>&1 || fail "age is not on PATH; the dependency installer provides it"
[[ -f "$identity" ]] || fail "no age identity at $identity; 'chezmoi apply' fetches it from 1Password (op://Private/secrets-backup.age/private key) -- never generate a new one, which opens none of the archives"

# Picks ARCHIVE, or the newest archive in the folders above.
if [[ -n "$archive" ]]; then
    [[ -f "$archive" ]] || fail "no archive at $archive"
else
    mapfile -t found < <(secrets_list_archives "${folders[@]}")
    archive="${found[0]:-}"
fi
if [[ -z "$archive" ]]; then
    [[ -z "$mirror_problem" ]] || warn "the mirror is not read: $mirror_problem"
    fail "no archive of $device in: ${folders[*]:-nowhere}; name one, or another device with --device"
fi

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

# Decrypt, then refuse the archive unless every entry belongs to a configured source and escapes
# nothing. Only then is anything extracted, and only the named sources, member by member.
age -d -i "$identity" -o "$stage/archive.tar" "$archive" ||
    fail "$archive does not decrypt with $identity: another key wrote it, or the file is damaged"
listing="$(tar -tf "$stage/archive.tar")" || fail "$archive holds no readable tar"
[[ -n "$listing" ]] || fail "$archive is empty"
while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    secrets_entry_allowed "$entry" "${sources[@]}" ||
        fail "$archive holds '$entry', which is outside the configured sources or escapes them; refusing it"
done <<<"$listing"

# The sources the archive actually carries, in the configured order: an entry equal to a source or
# under it means that source is present.
archived=()
for src in "${sources[@]}"; do
    while IFS= read -r entry; do
        if [[ "$entry" == "$src" || "$entry" == "$src/"* ]]; then
            archived+=("$src")
            break
        fi
    done <<<"$listing"
done
[[ ${#archived[@]} -gt 0 ]] || fail "$archive carries none of the configured sources (${sources[*]})"

log "restoring $archive into $restore_root"
log "  sources in the archive: ${archived[*]}"
if ! $yes; then
    [[ -t 0 ]] || fail "no terminal to ask on; pass --yes to restore without asking"
    read -r -p "[$prefix] restore these into $restore_root${force:+ (overwriting existing)}? [y/N] " answer
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]] || fail "not confirmed; nothing was changed"
fi

restored=0
skipped=0
for src in "${archived[@]}"; do
    if [[ -e "$restore_root/$src" ]] && ! $force; then
        warn "$restore_root/$src exists; leaving it (pass --force to overwrite)"
        skipped=$((skipped + 1))
        continue
    fi
    # tar creates the parent (e.g. .kube/ for .kube/config) and keeps the stored permissions; never
    # restores ownership to another UID.
    tar -x -C "$restore_root" -p --no-same-owner -f "$stage/archive.tar" -- "$src" ||
        fail "could not extract $src from $archive"
    log "restored $src"
    restored=$((restored + 1))
done

log "done; restored $restored source(s), left $skipped in place"
