{{- $llm := includeTemplate "lib-local-llm.tmpl" . | fromJson -}}
#!/bin/bash

# claude-local: Claude Code on the local Ollama model. See .docs/local-coding-model.md.
#
# `ollama launch claude` wires the provider for the one claude process it starts: the base URL
# and token, every model tier on one model, and the switches that keep Claude Code's prompt
# cacheable by Ollama -- the tokens-left reminder rewrites the prompt on every request, and the
# server would re-read all of it each turn. Anthropic does not support Claude Code on other
# models, so that list follows Claude Code's releases; Ollama maintains it, and this script adds
# only what it leaves out for a local model:
#
#   - The context window. Claude Code cannot read it from Ollama and assumes 200K for a model it
#     does not recognise, so nothing would compact before the server truncated the prompt. It is
#     rendered from the value OLLAMA_CONTEXT_LENGTH comes from, so the two cannot disagree.
#   - A lean profile, because what loads before the first prompt has to fit that window:
#       * CLAUDE_CONFIG_DIR=~/.claude-local leaves out the regular profile's plugins, skills,
#         agents and MCP servers, and keeps local transcripts and `/model` choices out of the
#         settings every cloud session reads.
#       * claudeMdExcludes keeps three global rules. A separate config directory alone does not
#         drop them: for any project under $HOME, Claude Code reads ~/.claude/rules as the rules
#         of the ancestor directory ~.
#       * --tools sends six tool schemas. For a model it does not recognise, Claude Code sends
#         every schema with every request instead of deferring the rarely used ones.
#
# Nothing is exported beyond this process, so the regular `claude`, its login and ccswitch's
# rotation are untouched: an ANTHROPIC_AUTH_TOKEN in the shell would override the rotated login.

set -euo pipefail

prefix="claude-local"
default_model={{ $llm.model | quote }}
model="${CLAUDE_LOCAL_MODEL:-$default_model}"
host="${OLLAMA_HOST:-127.0.0.1:11434}"
[[ "$host" == *://* ]] || host="http://$host"

if ! command -v ollama >/dev/null 2>&1; then
    echo "[$prefix] ERROR: ollama is not installed; run 'chezmoi apply'" >&2
    exit 1
fi

# `ollama launch` offers to install Claude Code by piping its installer into bash when it finds
# no `claude`, and --yes accepts. Claude Code comes from the dependency installer here instead.
if ! command -v claude >/dev/null 2>&1; then
    echo "[$prefix] ERROR: Claude Code is not installed" >&2
    exit 1
fi

server_up() {
    curl -fsS --max-time 2 "$host/api/version" >/dev/null 2>&1
}

# The user unit starts with the session but may have been stopped to give the GPU back, so start
# it on demand -- only when it is the server this would talk to.
if ! server_up; then
    if [[ "$host" == "http://127.0.0.1:11434" ]] && systemctl --user start ollama.service 2>/dev/null; then
        for _ in $(seq 1 30); do
            server_up && break
            sleep 1
        done
    fi
    if ! server_up; then
        echo "[$prefix] ERROR: no Ollama server answers at $host; check 'systemctl --user status ollama'" >&2
        exit 1
    fi
fi

export OLLAMA_HOST="$host"
export CLAUDE_CONFIG_DIR="${CLAUDE_LOCAL_CONFIG_DIR:-$HOME/.claude-local}"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS={{ int $llm.contextTokens }}
export CLAUDE_CODE_MAX_OUTPUT_TOKENS={{ int $llm.maxOutputTokens }}

settings={{ dict "claudeMdExcludes" (list (printf "%s/.claude/rules/!(%s).md" .chezmoi.homeDir (join "|" $llm.rules)) (printf "%s/.claude/CLAUDE.md" .chezmoi.homeDir)) | toJson | squote }}

# --tools takes a variadic list, so --settings goes between it and the caller's arguments: an
# option ends the list, where a prompt given as the first argument would join it as a tool name.
exec ollama launch claude --model "$model" --yes -- \
    --tools {{ join "," $llm.tools | quote }} --settings "$settings" "$@"
