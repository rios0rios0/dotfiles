#!/bin/bash

# Backs up the local OmniRoute stack: one age-encrypted archive per run, which omniroute-restore
# turns back into a working gateway on a machine that has nothing but the archive and the backup
# key. Inside it:
#
#   storage.sqlite  a consistent snapshot of the gateway's database, taken inside the container with
#                   `VACUUM INTO` over node:sqlite. Copying the file out of the volume while the
#                   gateway writes it can tear pages -- SQLite runs in WAL mode here -- and the
#                   image ships no sqlite3 CLI.
#   server.env      the secrets OmniRoute's bootstrap generated and persisted in the volume.
#   compose.env     the stack's own secrets, read from the container's environment, where Compose
#                   put local-services/omniroute/.env: its STORAGE_ENCRYPTION_KEY decrypts the
#                   provider credentials in the database. Only the keys lib-omniroute.sh allows.
#   manifest        the format, time, device, image, schema and counts: what a restore shows
#                   before it asks, and checks the image against. Read with grep, never sourced.
#   ca-bundle.pem   the CA bundle .env's OMNIROUTE_CA_BUNDLE names, when it names one of its own.
#
# The archive is encrypted with the age identity at ~/.ssh/omniroute-backup-key: a key for these
# backups alone, so losing or rotating the chezmoi identity never strands them, and the other way
# around. Its only copy off this machine is the `omniroute-backup.age` item in 1Password, which
# `chezmoi apply` fetches it from (run_before_linux-005) -- backups without it are unrecoverable.
#
# The newest archives are kept here, and each run copies its archive to the mirror, the personal
# OneDrive by default (.chezmoidata/omniroute.yaml), into a folder per device, so the archives
# outlive the machine. An empty gateway -- no provider and no API key -- is archived, but nothing is
# rotated out or copied for it: a freshly started one would otherwise push the real archives out of
# both places within two weeks. The systemd user timer omniroute-backup.timer runs this daily; run
# it by hand after any doubt.
#
# See CLAUDE.md, "OmniRoute Backups, Mirror and Restore", and .docs/omniroute-local.md.

set -euo pipefail
umask 077

prefix="omniroute-backup"
default_device={{ .deviceName | squote }}
default_keep={{ .omniroute.backup.keep | squote }}
default_mirror={{ .omniroute.backup.mirror | squote }}
default_mirror_keep={{ .omniroute.backup.mirrorKeep | squote }}
default_mirror_monthly={{ .omniroute.backup.mirrorMonthly | squote }}

container="${OMNIROUTE_CONTAINER:-dotfiles-omniroute-1}"
backup_dir="${OMNIROUTE_BACKUP_DIR:-$HOME/.local/share/omniroute-backups}"
keep="${OMNIROUTE_BACKUP_KEEP:-$default_keep}"
identity="${OMNIROUTE_BACKUP_IDENTITY:-$HOME/.ssh/omniroute-backup-key}"
device="${OMNIROUTE_BACKUP_DEVICE:-$default_device}"
# No colon: an empty OMNIROUTE_BACKUP_MIRROR switches the copy off for one run.
mirror="${OMNIROUTE_BACKUP_MIRROR-$default_mirror}"
mirror_keep="${OMNIROUTE_BACKUP_MIRROR_KEEP:-$default_mirror_keep}"
mirror_monthly="${OMNIROUTE_BACKUP_MIRROR_MONTHLY:-$default_mirror_monthly}"

{{ includeTemplate "lib-omniroute.sh" }}

log() { echo "[$prefix] $*" >&2; }
fail() { echo "[$prefix] ERROR: $*" >&2; exit 1; }

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat >&2 <<EOF
Usage: omniroute-backup [--help]

Snapshots the local OmniRoute stack and writes an age-encrypted tar.age archive to
$backup_dir, keeping the newest $keep and removing older ones, then copies it to the mirror
('${mirror:-none}'), under $device/, keeping the newest $mirror_keep there plus the newest of
each of the $mirror_monthly most recent months.

Environment overrides:
  OMNIROUTE_CONTAINER              the stack's container (default: dotfiles-omniroute-1)
  OMNIROUTE_BACKUP_DIR             where archives live (default: ~/.local/share/omniroute-backups)
  OMNIROUTE_BACKUP_KEEP            how many archives to keep there (default: $default_keep)
  OMNIROUTE_BACKUP_IDENTITY        age identity to encrypt with (default: ~/.ssh/omniroute-backup-key)
  OMNIROUTE_BACKUP_DEVICE          the mirror folder's name (default: $default_device)
  OMNIROUTE_BACKUP_MIRROR          'onedrive-personal', an absolute path, or empty for no copy
  OMNIROUTE_BACKUP_MIRROR_KEEP     how many of the newest to keep in the mirror (default: $default_mirror_keep)
  OMNIROUTE_BACKUP_MIRROR_MONTHLY  how many months keep their newest there (default: $default_mirror_monthly)

A missing identity file fails the run on purpose: silently not backing up is worse than a
failed unit. So does a mirror that cannot be written, after the archive is kept here. Docker or
the stack being down skips the run with a warning instead.
EOF
    exit 0
fi
if [[ $# -gt 0 ]]; then
    fail "unexpected argument '$1'; see --help"
fi

[[ "$keep" =~ ^[1-9][0-9]*$ ]] || fail "OMNIROUTE_BACKUP_KEEP must be a positive integer, got '$keep'"
[[ "$mirror_keep" =~ ^[1-9][0-9]*$ ]] || fail "OMNIROUTE_BACKUP_MIRROR_KEEP must be a positive integer, got '$mirror_keep'"
[[ "$mirror_monthly" =~ ^[0-9]+$ ]] || fail "OMNIROUTE_BACKUP_MIRROR_MONTHLY must be a whole number, got '$mirror_monthly'"
[[ "$device" =~ ^[A-Za-z0-9._-]+$ ]] || fail "'$device' cannot name a folder in the mirror; set OMNIROUTE_BACKUP_DEVICE"

command -v docker >/dev/null 2>&1 || {
    log "WARN: docker is not on PATH; there is no local stack to back up, skipping"
    exit 0
}
command -v age >/dev/null 2>&1 || fail "age is not on PATH; the dependency installer provides it"
command -v jq >/dev/null 2>&1 || fail "jq is not on PATH; the dependency installer provides it"
[[ -f "$identity" ]] || fail "no age identity at $identity; 'chezmoi apply' fetches it from 1Password (op://Private/omniroute-backup.age/private key) -- never generate a new one, which would not decrypt the backups already taken"

# One inspect says whether the gateway runs, which image it runs, and the environment Compose gave
# it. That environment holds the stack's secrets, so the JSON stays in this variable.
inspect="$(docker inspect "$container" 2>/dev/null)" || inspect="[]"
if [[ "$(jq -r '.[0].State.Running // false' <<<"$inspect" 2>/dev/null)" != "true" ]]; then
    log "WARN: container $container is not running (stack down or Docker daemon unreachable), skipping"
    exit 0
fi

mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

# A consistent copy of the live database, taken inside the container, and the numbers the manifest
# records about it, printed as one JSON line. The path must be single-quoted in the SQL: double
# quotes are identifiers in SQLite, not strings.
log "snapshotting $container:/app/data/storage.sqlite"
if ! stats="$(docker exec -i "$container" node - <<'MJS'
const fs = require("node:fs");
const { DatabaseSync } = require("node:sqlite");
const snapshot = "/app/data/.omniroute-backup-snapshot.sqlite";
try { fs.unlinkSync(snapshot); } catch {}
const source = new DatabaseSync("/app/data/storage.sqlite", { readOnly: true });
source.exec("VACUUM INTO '" + snapshot + "'");
source.close();
const copy = new DatabaseSync(snapshot, { readOnly: true });
const check = copy.prepare("PRAGMA integrity_check").get().integrity_check;
// A table a later schema renames reads as null instead of failing the backup.
const count = (sql) => {
    try {
        return copy.prepare(sql).get().n;
    } catch {
        return null;
    }
};
const stats = {
    schema: count("SELECT max(CAST(version AS INTEGER)) AS n FROM _omniroute_migrations"),
    providers: count("SELECT count(*) AS n FROM provider_connections"),
    api_keys: count("SELECT count(*) AS n FROM api_keys"),
};
copy.close();
if (check !== "ok") {
    console.error("integrity check failed: " + check);
    process.exit(1);
}
console.log(JSON.stringify(stats));
MJS
)"; then
    fail "the in-container snapshot failed; is the stack healthy?"
fi
stats="$(tail -n 1 <<<"$stats")"
schema="$(jq -r '.schema // "unknown"' <<<"$stats" 2>/dev/null)" || schema="unknown"
providers="$(jq -r '.providers // "unknown"' <<<"$stats" 2>/dev/null)" || providers="unknown"
api_keys="$(jq -r '.api_keys // "unknown"' <<<"$stats" 2>/dev/null)" || api_keys="unknown"

docker cp "$container:/app/data/.omniroute-backup-snapshot.sqlite" "$stage/storage.sqlite"
docker cp "$container:/app/data/server.env" "$stage/server.env"
# A leftover copy inside the container is harmless: the next run unlinks it before snapshotting.
docker exec "$container" rm -f /app/data/.omniroute-backup-snapshot.sqlite \
    || log "WARN: could not remove the in-container snapshot; the next run overwrites it"

# The stack's secrets, from the environment Compose built out of .env; never logged. A value that
# spans lines cannot travel as one KEY=value line, so it is named and left out.
jq -r --arg keys "^(${OMNIROUTE_ENV_KEYS})=" \
    '.[0].Config.Env[]? | select(test($keys)) | select(test("\n") | not)' <<<"$inspect" > "$stage/compose.env"
while IFS= read -r name; do
    log "WARN: $name spans several lines in the gateway's environment, so the archive does not carry it"
done < <(jq -r --arg keys "^(${OMNIROUTE_ENV_KEYS})=" \
    '.[0].Config.Env[]? | select(test($keys)) | select(test("\n")) | split("=")[0]' <<<"$inspect")
members=(storage.sqlite server.env compose.env manifest)

# The CA bundle is a file on this machine that the Compose file mounts into the gateway, so it is
# read from where .env says; the host's own bundle exists on every Linux machine and stays out.
ca_bundle="$(omniroute_env_value OMNIROUTE_CA_BUNDLE "$stage/compose.env")"
if [[ -n "$ca_bundle" && "$ca_bundle" != "$OMNIROUTE_DEFAULT_CA_BUNDLE" ]]; then
    if [[ -f "$ca_bundle" ]]; then
        cp "$ca_bundle" "$stage/ca-bundle.pem"
        members+=(ca-bundle.pem)
    else
        log "WARN: OMNIROUTE_CA_BUNDLE names $ca_bundle, which is not on this machine, so the archive carries no CA bundle"
    fi
fi

now="$(date -u +%s)"
timestamp="$(date -u -d "@$now" +%Y%m%dT%H%M%SZ)"
archive="$backup_dir/omniroute-$timestamp.tar.age"
image="$(jq -r '.[0].Config.Image // ""' <<<"$inspect")"
printf '%s\n' "format=2" "created=$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)" "device=$device" \
    "image=$image" "schema=$schema" "providers=$providers" "api_keys=$api_keys" > "$stage/manifest"

log "encrypting with $identity"
tar -C "$stage" -cf - "${members[@]}" | age -e -i "$identity" -o "$archive.tmp"
mv "$archive.tmp" "$archive"

# Decrypting the whole archive and listing it proves both that the identity opens it and that the
# tar is complete; age authenticates the payload as it streams, so a truncated or tampered file
# fails here rather than on the day of a restore.
if ! listing="$(age -d -i "$identity" "$archive" | tar -tf -)" ||
    [[ "$(LC_ALL=C sort <<<"$listing")" != "$(printf '%s\n' "${members[@]}" | LC_ALL=C sort)" ]]; then
    rm -f "$archive"
    fail "the new archive failed its decryption check; removed $archive"
fi
log "wrote $archive ($(du -h "$archive" | cut -f1); schema $schema, $providers provider(s), $api_keys API key(s))"

if [[ "$providers" == 0 && "$api_keys" == 0 ]]; then
    log "WARN: the gateway holds no provider and no API key, so this archive stays here, and nothing is rotated out or copied to the mirror: an empty gateway never replaces the real archives"
    exit 0
fi
if [[ ! "$providers" =~ ^[0-9]+$ || ! "$api_keys" =~ ^[0-9]+$ ]]; then
    log "WARN: could not count the gateway's providers and API keys (a renamed table?), so the database is treated as holding some"
fi

# Retention: newest first by mtime, everything past $keep goes. The names this script writes
# contain no whitespace, so an entry's mtime prefix is stripped at its first space.
while IFS= read -r entry; do
    old="${entry#* }"
    rm -f -- "$old"
    log "removed the old archive $old"
done < <(find "$backup_dir" -maxdepth 1 -type f -name 'omniroute-*.tar.age' -printf '%T@ %p\n' \
    | sort -rn | tail -n +"$((keep + 1))")

if [[ -z "$mirror" ]]; then
    log "done; the newest $keep archive(s) stay in $backup_dir, and no mirror is configured"
    exit 0
fi

# The copy off this machine: written beside its final name and renamed, then compared, so the mirror
# never holds a partial archive under a real name. A failure fails the run -- the timer's unit shows
# it -- after the archive above is kept.
omniroute_mirror_resolve "$mirror" ||
    fail "the archive was not copied off this machine: $OMNIROUTE_MIRROR_ERROR; $archive stays in $backup_dir"
dest="$OMNIROUTE_MIRROR_ROOT/$device"
name="${archive##*/}"
if ! { mkdir -p "$dest" && cp -- "$archive" "$dest/$name.tmp" && mv -f -- "$dest/$name.tmp" "$dest/$name" &&
    cmp -s -- "$archive" "$dest/$name"; }; then
    rm -f -- "$dest/$name.tmp"
    fail "could not copy $archive to $dest; it stays in $backup_dir"
fi
log "copied it to $dest"

# Mirror retention: the newest $mirror_keep, plus the newest archive of each of the $mirror_monthly
# most recent months, so a problem noticed late still finds an archive from before it. The names
# order the archives, newest first; the month is the YYYYMM after "omniroute-".
mapfile -t mirrored < <(omniroute_list_archives "$dest")
declare -A kept=()
months=0
last_month=""
for index in "${!mirrored[@]}"; do
    entry="${mirrored[$index]##*/}"
    month="${entry:10:6}"
    if (( index < mirror_keep )); then
        kept[$entry]=1
    fi
    if [[ "$month" != "$last_month" ]]; then
        last_month="$month"
        if (( months < mirror_monthly )); then
            kept[$entry]=1
        fi
        months=$((months + 1))
    fi
done
for path in "${mirrored[@]}"; do
    [[ -n "${kept[${path##*/}]:-}" ]] && continue
    rm -f -- "$path"
    log "removed the old mirrored archive $path"
done
# A copy interrupted mid-write leaves its .tmp behind; an hour on, nothing is still writing it.
find "$dest" -maxdepth 1 -type f -name 'omniroute-*.tar.age.tmp' -mmin +60 -delete 2>/dev/null || true

log "done; the newest $keep archive(s) stay in $backup_dir, and the mirror keeps its own in $dest"
