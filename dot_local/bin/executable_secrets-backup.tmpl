#!/bin/bash

# Backs up the home-secrets folders -- security-tool state and cluster config that stopped syncing
# through chezmoi in #276 -- as one age-encrypted archive per run, which secrets-restore puts back
# on a machine that has nothing but the archive and the backup key. Inside it: whatever of
# secretsBackup.sources exists (~/.john, ~/.sqlmap, ~/.kube/config, ~/.kube/config-files), packed
# from $HOME so the paths restore where they came from.
#
# The archive is encrypted with the age identity at ~/.ssh/secrets-backup-key: a key for these
# backups alone, so losing or rotating the chezmoi identity -- or the OmniRoute one -- never strands
# them. Its only copy off this machine is the `secrets-backup.age` item in 1Password, which
# `chezmoi apply` fetches it from (run_before_linux-005) -- backups without it are unrecoverable.
#
# The newest archives are kept here, and each run copies its archive to the mirror, the personal
# OneDrive by default (.chezmoidata/secrets-backup.yaml), into a folder per device, so the archives
# outlive the machine. The systemd user timer secrets-backup.timer runs this daily; run it by hand
# whenever you want a fresh copy.
#
# See CLAUDE.md, "Home-Secrets Backups", and .docs/secrets-backup.md.

set -euo pipefail
umask 077

prefix="secrets-backup"
default_device={{ .deviceName | squote }}
default_keep={{ .secretsBackup.keep | squote }}
default_mirror={{ .secretsBackup.mirror | squote }}
default_mirror_keep={{ .secretsBackup.mirrorKeep | squote }}
default_mirror_monthly={{ .secretsBackup.mirrorMonthly | squote }}
default_sources={{ .secretsBackup.sources | join " " | squote }}

root="${SECRETS_BACKUP_ROOT:-$HOME}"
backup_dir="${SECRETS_BACKUP_DIR:-$HOME/.local/share/secrets-backups}"
keep="${SECRETS_BACKUP_KEEP:-$default_keep}"
identity="${SECRETS_BACKUP_IDENTITY:-$HOME/.ssh/secrets-backup-key}"
device="${SECRETS_BACKUP_DEVICE:-$default_device}"
# No colon: an empty SECRETS_BACKUP_MIRROR switches the copy off for one run.
mirror="${SECRETS_BACKUP_MIRROR-$default_mirror}"
mirror_keep="${SECRETS_BACKUP_MIRROR_KEEP:-$default_mirror_keep}"
mirror_monthly="${SECRETS_BACKUP_MIRROR_MONTHLY:-$default_mirror_monthly}"
sources_override="${SECRETS_BACKUP_SOURCES:-}"

{{ includeTemplate "lib-secrets-backup.sh" }}

log() { echo "[$prefix] $*" >&2; }
fail() { echo "[$prefix] ERROR: $*" >&2; exit 1; }

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat >&2 <<EOF
Usage: secrets-backup [--help]

Packs the home-secrets folders ($default_sources) that exist under $root into an
age-encrypted tar.age archive in $backup_dir, keeping the newest $keep and removing older ones,
then copies it to the mirror ('${mirror:-none}'), under $device/, keeping the newest $mirror_keep
there plus the newest of each of the $mirror_monthly most recent months.

Environment overrides:
  SECRETS_BACKUP_ROOT             the directory the sources are under (default: \$HOME)
  SECRETS_BACKUP_SOURCES          space-separated sources to pack (default: $default_sources)
  SECRETS_BACKUP_DIR              where archives live (default: ~/.local/share/secrets-backups)
  SECRETS_BACKUP_KEEP             how many archives to keep there (default: $default_keep)
  SECRETS_BACKUP_IDENTITY         age identity to encrypt with (default: ~/.ssh/secrets-backup-key)
  SECRETS_BACKUP_DEVICE           the mirror folder's name (default: $default_device)
  SECRETS_BACKUP_MIRROR           'onedrive-personal', an absolute path, or empty for no copy
  SECRETS_BACKUP_MIRROR_KEEP      how many of the newest to keep in the mirror (default: $default_mirror_keep)
  SECRETS_BACKUP_MIRROR_MONTHLY   how many months keep their newest there (default: $default_mirror_monthly)

A missing identity file fails the run on purpose: silently not backing up is worse than a
failed unit. So does a mirror that cannot be written, after the archive is kept here. A run with
none of the sources present is a no-op with a warning.
EOF
    exit 0
fi
if [[ $# -gt 0 ]]; then
    fail "unexpected argument '$1'; see --help"
fi

[[ "$keep" =~ ^[1-9][0-9]*$ ]] || fail "SECRETS_BACKUP_KEEP must be a positive integer, got '$keep'"
[[ "$mirror_keep" =~ ^[1-9][0-9]*$ ]] || fail "SECRETS_BACKUP_MIRROR_KEEP must be a positive integer, got '$mirror_keep'"
[[ "$mirror_monthly" =~ ^[0-9]+$ ]] || fail "SECRETS_BACKUP_MIRROR_MONTHLY must be a whole number, got '$mirror_monthly'"
[[ "$device" =~ ^[A-Za-z0-9._-]+$ ]] || fail "'$device' cannot name a folder in the mirror; set SECRETS_BACKUP_DEVICE"

command -v age >/dev/null 2>&1 || fail "age is not on PATH; the dependency installer provides it"
[[ -f "$identity" ]] || fail "no age identity at $identity; 'chezmoi apply' fetches it from 1Password (op://Private/secrets-backup.age/private key) -- never generate a new one, which would not decrypt the backups already taken"
[[ -d "$root" ]] || fail "the source root $root does not exist"

read -ra sources <<<"${sources_override:-$default_sources}"
[[ ${#sources[@]} -gt 0 ]] || fail "no sources configured"

# The sources present under $root; the rest are skipped, so a machine without one still backs up
# what it has. Each must be a plain relative path, the same shape the restore allowlist checks.
present=()
for src in "${sources[@]}"; do
    secrets_entry_allowed "$src" "$src" || fail "source '$src' is not a safe relative path"
    if [[ -e "$root/$src" ]]; then
        present+=("$src")
    else
        log "WARN: $root/$src does not exist, skipping it"
    fi
done
if [[ ${#present[@]} -eq 0 ]]; then
    log "WARN: none of the sources ($default_sources) exist under $root; nothing to back up"
    exit 0
fi

mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

# tar to a file first so its exit code is read on its own: GNU tar exits 1 when a file changes
# while it is read (john or sqlmap may be writing), which is a usable snapshot, and 2 on a real
# failure. Permissions are kept, so a restored ~/.kube/config comes back mode 600.
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="$backup_dir/secrets-$timestamp.tar.age"
tar_rc=0
tar -C "$root" -cf "$stage/archive.tar" -- "${present[@]}" 2>"$stage/tar.err" || tar_rc=$?
if (( tar_rc > 1 )); then
    cat "$stage/tar.err" >&2 || true
    fail "tar failed (exit $tar_rc) packing ${present[*]}"
fi
(( tar_rc == 1 )) && log "WARN: a file changed while being archived (tar exit 1); the snapshot is still usable"

log "encrypting ${present[*]} with $identity"
age -e -i "$identity" -o "$archive.tmp" <"$stage/archive.tar"
mv "$archive.tmp" "$archive"

# Decrypting the whole archive and listing it proves the identity opens it and the tar is complete
# -- age authenticates the payload as it streams -- and that every entry belongs to a source, so a
# bug never writes an archive the restore would then refuse.
if ! listing="$(age -d -i "$identity" "$archive" | tar -tf -)"; then
    rm -f "$archive"
    fail "the new archive failed its decryption check; removed $archive"
fi
[[ -n "$listing" ]] || { rm -f "$archive"; fail "the new archive is empty; removed $archive"; }
while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    secrets_entry_allowed "$entry" "${present[@]}" || {
        rm -f "$archive"
        fail "the new archive holds '$entry', outside the sources; removed $archive"
    }
done <<<"$listing"
log "wrote $archive ($(du -h "$archive" | cut -f1); ${#present[@]} source(s): ${present[*]})"

# Retention: newest first by mtime, everything past $keep goes. The names this script writes
# contain no whitespace, so an entry's mtime prefix is stripped at its first space.
while IFS= read -r entry; do
    old="${entry#* }"
    rm -f -- "$old"
    log "removed the old archive $old"
done < <(find "$backup_dir" -maxdepth 1 -type f -name 'secrets-*.tar.age' -printf '%T@ %p\n' \
    | sort -rn | tail -n +"$((keep + 1))")

if [[ -z "$mirror" ]]; then
    log "done; the newest $keep archive(s) stay in $backup_dir, and no mirror is configured"
    exit 0
fi

# The copy off this machine: written beside its final name and renamed, then compared, so the mirror
# never holds a partial archive under a real name. A failure fails the run after the archive above
# is kept here.
secrets_mirror_resolve "$mirror" ||
    fail "the archive was not copied off this machine: $SECRETS_MIRROR_ERROR; $archive stays in $backup_dir"
dest="$SECRETS_MIRROR_ROOT/$device"
name="${archive##*/}"
if ! { mkdir -p "$dest" && cp -- "$archive" "$dest/$name.tmp" && mv -f -- "$dest/$name.tmp" "$dest/$name" &&
    cmp -s -- "$archive" "$dest/$name"; }; then
    rm -f -- "$dest/$name.tmp"
    fail "could not copy $archive to $dest; it stays in $backup_dir"
fi
log "copied it to $dest"

# Mirror retention: the newest $mirror_keep, plus the newest archive of each of the $mirror_monthly
# most recent months, so a problem noticed late still finds an archive from before it. The names
# order the archives, newest first; the month is the YYYYMM after "secrets-".
mapfile -t mirrored < <(secrets_list_archives "$dest")
declare -A kept=()
months=0
last_month=""
for index in "${!mirrored[@]}"; do
    entry="${mirrored[$index]##*/}"
    month="${entry:8:6}"
    if (( index < mirror_keep )); then
        kept[$entry]=1
    fi
    if [[ "$month" != "$last_month" ]]; then
        last_month="$month"
        if (( months < mirror_monthly )); then
            kept[$entry]=1
        fi
        months=$((months + 1))
    fi
done
for path in "${mirrored[@]}"; do
    [[ -n "${kept[${path##*/}]:-}" ]] && continue
    rm -f -- "$path"
    log "removed the old mirrored archive $path"
done
# A copy interrupted mid-write leaves its .tmp behind; an hour on, nothing is still writing it.
find "$dest" -maxdepth 1 -type f -name 'secrets-*.tar.age.tmp' -mmin +60 -delete 2>/dev/null || true

log "done; the newest $keep archive(s) stay in $backup_dir, and the mirror keeps its own in $dest"
