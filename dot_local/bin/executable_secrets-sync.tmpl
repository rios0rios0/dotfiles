#!/bin/bash

# Syncs the home-secrets folders between devices through the personal OneDrive, without a server:
# every device writes one snapshot per tool to the hub -- %OneDriveConsumer%\Backup\sync\<tool>\
# <device>.tar.age -- and merges everyone's into its own folders. The tools, and how each one
# merges, come from .chezmoidata/secrets-sync.yaml:
#
#   entries  each file or folder directly inside the tool's folder is one entry (a kubeconfig in
#            ~/.kube/config-files, a target in ~/.sqlmap/output); the newest wins, and a deleted
#            entry is deleted everywhere
#   lines    the tool's file is a set of lines (~/.john/john.pot); every device's lines join, and a
#            deleted line is deleted everywhere
#
# OneDrive has no locking: two devices rewriting one file before it syncs leave a renamed copy
# behind, a silent fork. So no device ever writes another's snapshot, and the merge happens on read.
#
# A delete needs memory. Each device keeps the state it last synced, its base (under
# ~/.local/state/secrets-sync): an entry in the base and gone from the folder is a delete, published
# as a tombstone dated just after this device last saw the entry. It beats every copy that existed
# then and loses to a change made since, so a delete never silently wipes a concurrent edit. A
# device without a base is joining and deletes nothing; its files compete by modification time, so a
# machine restored from an old archive takes the newer copies rather than pushing its old ones out.
# A local change that loses to a newer one is kept under the state folder's conflicts/.
#
# Two guards stop one mistake from emptying every device: a tool's folder that vanished is not read
# as deleting everything in it, and a run that would delete more than maxDeletePercent of a tool's
# entries stops until it is run with --allow-deletes.
#
# Snapshots are encrypted to the home-secrets backup key (~/.ssh/secrets-backup-key), and each
# manifest carries an HMAC keyed from that key's secret half. The recipient is public
# (.chezmoidata/age-keys.yaml), so encryption alone would let anyone who can write to the OneDrive
# plant a kubeconfig whose exec plugin then runs on every device; the MAC takes the private key.
#
# The daily backups stay underneath (secrets-backup): a sync copies mistakes too, and the dated
# archives are the way back. The systemd user timer secrets-sync.timer runs this hourly.
#
# See CLAUDE.md, "Home-Secrets Sync", and .docs/secrets-sync.md.

set -euo pipefail
umask 077

prefix="secrets-sync"
default_device={{ .deviceName | squote }}
default_hub={{ .secretsSync.hub | squote }}
default_tombstone_days={{ .secretsSync.tombstoneDays | squote }}
default_max_delete_percent={{ .secretsSync.maxDeletePercent | squote }}
# The tools, in the order .chezmoidata/secrets-sync.yaml lists them: a name, a path under $HOME, how
# it merges, and the lines its files keep to themselves (an extended regular expression, or empty).
tool_names=({{ range .secretsSync.tools }} {{ .name | squote }}{{ end }})
tool_paths=({{ range .secretsSync.tools }} {{ .path | squote }}{{ end }})
tool_merges=({{ range .secretsSync.tools }} {{ .merge | squote }}{{ end }})
tool_local_lines=({{ range .secretsSync.tools }} {{ get . "localLines" | default "" | squote }}{{ end }})

root="${SECRETS_SYNC_ROOT:-$HOME}"
identity="${SECRETS_BACKUP_IDENTITY:-$HOME/.ssh/secrets-backup-key}"
device="${SECRETS_SYNC_DEVICE:-$default_device}"
# No colon: an empty SECRETS_SYNC_HUB switches the sync off for one run.
hub="${SECRETS_SYNC_HUB-$default_hub}"
state_root="${SECRETS_SYNC_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/secrets-sync}"
tombstone_days="${SECRETS_SYNC_TOMBSTONE_DAYS:-$default_tombstone_days}"
max_delete_percent="${SECRETS_SYNC_MAX_DELETE_PERCENT:-$default_max_delete_percent}"
only_tools="${SECRETS_SYNC_TOOLS:-}"
now="${SECRETS_SYNC_NOW:-$(date +%s)}"

{{ includeTemplate "lib-secrets-backup.sh" }}

log() { echo "[$prefix] $*" >&2; }
warn() { echo "[$prefix] WARN: $*" >&2; }
fail() { echo "[$prefix] ERROR: $*" >&2; exit 1; }

usage() {
    cat >&2 <<EOF
Usage: secrets-sync [--dry-run] [--allow-deletes] [--help]

Merges this device's copy of each home-secrets tool (${tool_names[*]}) with the other devices'
snapshots in the hub ('${hub:-none}'), under $root, then publishes this device's ($device).

  --dry-run        say what would change, and change nothing
  --allow-deletes  let this run delete more than $max_delete_percent% of a tool's entries, or treat a
                   tool folder that is gone as deleted everywhere

Environment overrides:
  SECRETS_SYNC_ROOT               the directory the tools are under (default: \$HOME)
  SECRETS_SYNC_HUB                'onedrive-personal', an absolute path, or empty to sync nothing
  SECRETS_SYNC_DEVICE             this device's snapshot name (default: $default_device)
  SECRETS_SYNC_STATE              where the bases and the kept conflicts live
                                  (default: ~/.local/state/secrets-sync)
  SECRETS_SYNC_TOOLS              space-separated tools to sync (default: all)
  SECRETS_SYNC_TOMBSTONE_DAYS     how long a delete is remembered (default: $default_tombstone_days)
  SECRETS_SYNC_MAX_DELETE_PERCENT the share of a tool one run may delete (default: $default_max_delete_percent)
  SECRETS_BACKUP_IDENTITY         the age identity (default: ~/.ssh/secrets-backup-key)

A local change that loses to a newer one from another device is kept under
$state_root/conflicts. The daily backups (secrets-backup) hold the history.
EOF
}

dry_run=false
allow_deletes=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dry-run) dry_run=true ;;
        --allow-deletes) allow_deletes=true ;;
        *) fail "unexpected argument '$1'; see --help" ;;
    esac
    shift
done

[[ "$device" =~ ^[A-Za-z0-9._-]+$ ]] || fail "'$device' cannot name a snapshot in the hub; set SECRETS_SYNC_DEVICE"
[[ "$tombstone_days" =~ ^[1-9][0-9]*$ ]] || fail "SECRETS_SYNC_TOMBSTONE_DAYS must be a positive integer, got '$tombstone_days'"
if [[ ! "$max_delete_percent" =~ ^[0-9]+$ ]] || (( max_delete_percent > 100 )); then
    fail "SECRETS_SYNC_MAX_DELETE_PERCENT must be a whole number from 0 to 100, got '$max_delete_percent'"
fi
[[ "$now" =~ ^[0-9]+$ ]] || fail "SECRETS_SYNC_NOW must be seconds since the epoch, got '$now'"
cutoff=$(( now - tombstone_days * 86400 ))

if [[ -z "$hub" ]]; then
    log "no hub is configured (secretsSync.hub is empty); nothing to sync"
    exit 0
fi
for tool in age flock tar sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "$tool is not on PATH; the dependency installer provides it"
done
[[ -f "$identity" ]] || fail "no age identity at $identity; 'chezmoi apply' fetches it from 1Password (op://Private/secrets-backup.age/private key) -- never generate a new one, which opens none of the snapshots"
[[ -d "$root" ]] || fail "the root $root does not exist"

for index in "${!tool_names[@]}"; do
    [[ "${tool_names[$index]}" =~ ^[a-z0-9-]+$ ]] || fail "the tool name '${tool_names[$index]}' cannot name a hub folder"
    secrets_entry_allowed "${tool_paths[$index]}" "${tool_paths[$index]}" ||
        fail "the path '${tool_paths[$index]}' of ${tool_names[$index]} is not a safe relative path"
    case "${tool_merges[$index]}" in
        entries) ;;
        lines) [[ -z "${tool_local_lines[$index]}" ]] || fail "${tool_names[$index]} merges lines, which keep no local lines" ;;
        *) fail "${tool_names[$index]} merges '${tool_merges[$index]}', which is neither 'entries' nor 'lines'" ;;
    esac
    if [[ -n "${tool_local_lines[$index]}" ]]; then
        status=0
        grep -E -- "${tool_local_lines[$index]}" /dev/null || status=$?
        (( status < 2 )) || fail "the localLines of ${tool_names[$index]} is not an extended regular expression"
    fi
done
for name in $only_tools; do
    [[ " ${tool_names[*]} " == *" $name "* ]] || fail "SECRETS_SYNC_TOOLS names '$name', which is not a configured tool"
done

secrets_mirror_resolve "$hub" "Backup/sync" "secretsSync.hub" || fail "the hub cannot be reached: $SECRETS_MIRROR_ERROR"
hub_root="$SECRETS_MIRROR_ROOT"

mkdir -p "$state_root"
chmod 700 "$state_root"
exec 9>>"$state_root/lock"
flock -w 120 9 || fail "another secrets-sync is still running (it holds $state_root/lock)"

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

# --- hashing and the MAC ---------------------------------------------------------------------------

# Prints the bytes a hex string names as printf %b escapes.
hex_escapes() {
    local hex="$1" out="" i
    for ((i = 0; i < ${#hex}; i += 2)); do
        out+="\\x${hex:i:2}"
    done
    printf '%s' "$out"
}

# hmac_sha256 <hex key> <file>: HMAC-SHA256 (RFC 2104) of the file. The key never reaches a command
# line, where any local user could read it in /proc/<pid>/cmdline: printf, a builtin, builds the
# pads, and they reach sha256sum on stdin.
hmac_sha256() {
    local key="$1" file="$2" ipad="" opad="" inner i byte
    while (( ${#key} < 128 )); do
        key+="0"
    done
    for ((i = 0; i < 128; i += 2)); do
        byte=$((16#${key:i:2}))
        printf -v ipad '%s\\x%02x' "$ipad" $((byte ^ 0x36))
        printf -v opad '%s\\x%02x' "$opad" $((byte ^ 0x5c))
    done
    inner="$({ printf '%b' "$ipad"; cat -- "$file"; } | sha256sum)"
    { printf '%b' "$opad"; printf '%b' "$(hex_escapes "${inner:0:64}")"; } | sha256sum | cut -c1-64
}

# The MAC key: the identity's secret half hashed under a label of its own, so the MAC never uses the
# key age decrypts with as it is.
secret_line="$(grep -m 1 '^AGE-SECRET-KEY-1' -- "$identity")" || fail "$identity holds no age secret key"
mac_key="$({ printf '%s\n' 'secrets-sync manifest key v1'; printf '%s' "$secret_line"; } | sha256sum | cut -c1-64)"
unset secret_line

# file_digest <file>: the SHA-256 of a file as it syncs, without the lines it keeps to itself.
file_digest() {
    if [[ -n "$local_lines" ]]; then
        { LC_ALL=C grep -a -v -E -- "$local_lines" "$1" || [[ $? -eq 1 ]]; } | sha256sum | cut -c1-64
    else
        sha256sum <"$1" | cut -c1-64
    fi
}

# tree_digest <dir>: the SHA-256 of a folder as it syncs: every path below it, and every file's
# content, in byte order.
tree_digest() {
    (
        cd -- "$1"
        {
            find . -mindepth 1 -type d -printf 'd %P\n'
            find . -type f -print0 | xargs -0 -r sha256sum --
        } | LC_ALL=C sort | sha256sum | cut -c1-64
    )
}

# tree_mtime <dir>: the newest modification time in a folder, in whole seconds.
tree_mtime() {
    local newest
    newest="$(find "$1" -printf '%T@\n' | sort -n | tail -n 1)"
    printf '%s\n' "${newest%.*}"
}

# A name an entry may have: one path component, none of this script's temporary names, and nothing
# the manifest's lines cannot carry.
entry_name_ok() {
    [[ -n "$1" && "$1" != "." && "$1" != ".." && "$1" != "@" && "$1" != "*" ]] || return 1
    [[ "$1" != */* && "$1" != .secrets-sync.* && "$1" != *[[:cntrl:]]* ]]
}

# record_ok <state> <time> <hash> <key>: whether a record is well formed for this tool. Entries are
# keyed by name and carry their content's digest while live; lines are keyed by their digest.
record_ok() {
    [[ "$2" =~ ^[0-9]{1,12}$ ]] || return 1
    case "$merge:$1" in
        entries:live) [[ "$3" =~ ^[0-9a-f]{64}$ ]] && entry_name_ok "$4" ;;
        entries:dead) [[ "$3" == - ]] && entry_name_ok "$4" ;;
        lines:live|lines:dead) [[ "$3" == - && "$4" =~ ^[0-9a-f]{64}$ ]] ;;
        *) return 1 ;;
    esac
}

# record_beats <state> <time> <hash> <state> <time> <hash>: whether the first record is newer than
# the second. The newer time wins; at the same time a live record beats a delete, and otherwise the
# higher digest wins, so every device picks the same one.
record_beats() {
    (( $2 != $5 )) && { (( $2 > $5 )); return; }
    [[ "$1" != "$4" ]] && { [[ "$1" == live ]]; return; }
    [[ "$3" > "$6" ]]
}

# offer <key> <state> <time> <hash> <source>: makes the record the key's winner when it is newer
# than the one held. A delete older than tombstoneDays is forgotten, as if it had never been made.
offer() {
    if [[ "$2" == dead ]] && (( $3 < cutoff )); then
        return 0
    fi
    if [[ -n "${win_state[$1]+set}" ]] &&
        ! record_beats "$2" "$3" "$4" "${win_state[$1]}" "${win_time[$1]}" "${win_hash[$1]}"; then
        return 0
    fi
    win_state[$1]="$2"
    win_time[$1]="$3"
    win_hash[$1]="$4"
    win_source[$1]="$5"
}

# The keys that have a winner, in byte order, one per line (none at all when there is none).
win_keys() {
    if (( ${#win_state[@]} > 0 )); then
        printf '%s\n' "${!win_state[@]}" | LC_ALL=C sort
    fi
}

# --- manifests ---------------------------------------------------------------------------------------

# manifest_write <out> <records file> [<content digest>]: a manifest for this device's snapshot,
# ending in a MAC over every line before it.
manifest_write() {
    local out="$1" records="$2" content="${3:-}"
    {
        printf 'secrets-sync-manifest\t1\n'
        printf 'tool\t%s\n' "$tool"
        printf 'merge\t%s\n' "$merge"
        printf 'device\t%s\n' "$device"
        printf 'written\t%s\n' "$now"
        if [[ -n "$content" ]]; then
            printf 'content\t%s\n' "$content"
        fi
        cat -- "$records"
    } >"$out.body"
    {
        cat -- "$out.body"
        printf 'mac\t%s\n' "$(hmac_sha256 "$mac_key" "$out.body")"
    } >"$out"
    rm -f -- "$out.body"
}

# manifest_verify <file>: whether the manifest's last line is a MAC over every line before it, from a
# device that holds this key.
manifest_verify() {
    local last
    last="$(tail -n 1 -- "$1")"
    [[ "$last" =~ ^mac$'\t'([0-9a-f]{64})$ ]] || return 1
    head -n -1 -- "$1" >"$stage/mac-body"
    [[ "$(hmac_sha256 "$mac_key" "$stage/mac-body")" == "${BASH_REMATCH[1]}" ]]
}

# manifest_field <file> <name>: a header field's value.
manifest_field() {
    sed -n "s/^$2\t//p" -- "$1" | head -n 1
}

# snapshot_shape_ok <tar>: whether a decrypted snapshot holds a manifest and data/ alone, as regular
# files and folders that escape nothing. The MAC already vouches for the device that wrote it; this
# keeps a damaged one from writing anywhere.
snapshot_shape_ok() {
    local entry
    tar -tf "$1" >/dev/null 2>&1 || return 1
    secrets_tar_types_ok "$1" || return 1
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        secrets_entry_allowed "$entry" manifest data || return 1
    done < <(tar -tf "$1")
}

# peers_read: decrypts every snapshot in this tool's hub folder -- this device's own included, which
# is how a reinstalled device finds what it published before -- and keeps those that authenticate,
# in peer_tar/peer_device/peer_manifest. A snapshot that cannot be read yet (still downloading, or
# offline) is skipped quietly; one that does not authenticate is skipped and counted in suspicious.
peers_read() {
    local dir="$hub_root/$tool" file name index=0 tarfile manifest err
    peer_tar=()
    peer_device=()
    peer_manifest=()
    [[ -d "$dir" ]] || return 0
    while IFS= read -r -d '' file; do
        name="${file##*/}"
        [[ "$name" =~ ^[A-Za-z0-9._-]+\.tar\.age$ ]] || continue
        tarfile="$stage/peer-$index.tar"
        manifest="$stage/peer-$index.manifest"
        if ! err="$(age -d -i "$identity" -o "$tarfile" "$file" 2>&1)"; then
            if [[ "$err" == *"no identity matched"* ]]; then
                warn "$tool: $name is encrypted to another key; skipping it"
                suspicious=$((suspicious + 1))
            else
                warn "$tool: $name cannot be read whole yet (still downloading, or offline?); skipping it this run"
            fi
            continue
        fi
        if ! snapshot_shape_ok "$tarfile" || ! tar -xOf "$tarfile" manifest >"$manifest" 2>/dev/null ||
            ! manifest_verify "$manifest"; then
            warn "$tool: $name fails its authentication check -- no device holding this key wrote it (planted, or damaged); skipping it"
            suspicious=$((suspicious + 1))
            continue
        fi
        if [[ "$(head -n 1 -- "$manifest")" != $'secrets-sync-manifest\t1' ||
            "$(manifest_field "$manifest" tool)" != "$tool" || "$(manifest_field "$manifest" merge)" != "$merge" ]]; then
            warn "$tool: $name was written for another tool or merge, or by another version; skipping it"
            continue
        fi
        peer_tar[index]="$tarfile"
        peer_device[index]="$(manifest_field "$manifest" device)"
        peer_manifest[index]="$manifest"
        index=$((index + 1))
    done < <(find "$dir" -maxdepth 1 -type f -name '*.tar.age' -print0 | sort -z)
}

# peer_records <index>: the peer's well-formed records, one `<state> <time> <hash> <key>` per line.
peer_records() {
    local tag state time hash key
    while IFS=$'\t' read -r tag state time hash key; do
        [[ "$tag" == r ]] || continue
        if record_ok "$state" "$time" "$hash" "$key"; then
            printf '%s\t%s\t%s\t%s\n' "$state" "$time" "$hash" "$key"
        else
            warn "$tool: ${peer_device[$1]}'s snapshot holds a malformed record; ignoring it"
        fi
    done <"${peer_manifest[$1]}"
}

# The base: the records this device last synced, and when. base_synced is 0 before the first sync.
base_load() {
    local tag state time hash key
    base_state=()
    base_time=()
    base_hash=()
    base_synced=0
    [[ -f "$state_dir/base" ]] || return 0
    while IFS=$'\t' read -r tag state time hash key; do
        case "$tag" in
            synced) base_synced="$state" ;;
            r)
                record_ok "$state" "$time" "$hash" "$key" || continue
                base_state[$key]="$state"
                base_time[$key]="$time"
                base_hash[$key]="$hash"
                ;;
        esac
    done <"$state_dir/base"
    [[ "$base_synced" =~ ^[0-9]+$ ]] || base_synced=0
}

base_has_live() {
    local key
    for key in "${!base_state[@]}"; do
        [[ "${base_state[$key]}" == live ]] && return 0
    done
    return 1
}

# base_write <records file>: replaces the base, atomically.
base_write() {
    {
        printf 'secrets-sync-base\t1\n'
        printf 'synced\t%s\n' "$now"
        cat -- "$1"
    } >"$state_dir/base.tmp"
    mv -f -- "$state_dir/base.tmp" "$state_dir/base"
}

# A delete made here is dated just after this device last saw the entry: it beats every copy that
# existed then, and loses to a change made since, which this device never saw.
dead_time() {
    printf '%s\n' $(( base_synced > 0 ? base_synced + 1 : now ))
}

# conflict_keep <path> <name> <other device>: keeps a local change that lost to a newer one.
conflict_keep() {
    local dest
    dest="$state_root/conflicts/$tool/$(date -u -d "@$now" +%Y%m%dT%H%M%SZ)" || return 1
    { mkdir -p -- "$dest" && cp -a -- "$1" "$dest/$2"; } || return 1
    warn "$tool: this device's change to $2 lost to a newer one from $3; kept it in $dest/$2"
}

# delete_guard <deletes> <of> <what>: stops a run that would publish deletes of more than
# max_delete_percent of what this device held, unless --allow-deletes. A single delete always passes.
delete_guard() {
    if (( $1 >= 2 && $1 * 100 > max_delete_percent * $2 )) && ! $allow_deletes; then
        warn "$tool: this run would delete $1 of $2 $3, more than $max_delete_percent%; nothing was changed"
        warn "$tool: if that is meant, run 'secrets-sync --allow-deletes'; otherwise put the entries back (secrets-restore)"
        return 1
    fi
}

# publish <records file> [<content digest>]: writes this device's snapshot of $pub (manifest and
# data/) to the hub, unless it says nothing the last one did not. The copy is written beside its
# final name and renamed, so the hub never holds half a snapshot under a real name.
publish() {
    local records="$1" content="${2:-}" digest dest="$hub_root/$tool/$device.tar.age"
    digest="$(
        {
            printf '%s\n' "$tool" "$merge" "$content"
            cat -- "$records"
        } | sha256sum | cut -c1-64
    )"
    if [[ -f "$dest" && "$(cat -- "$state_dir/published" 2>/dev/null)" == "$digest" ]]; then
        return 0
    fi
    manifest_write "$pub/manifest" "$records" "$content"
    tar --sort=name --owner=0 --group=0 --numeric-owner -C "$pub" -cf "$stage/publish.tar" manifest data
    age -e -i "$identity" -o "$stage/publish.tar.age" "$stage/publish.tar"
    age -d -i "$identity" "$stage/publish.tar.age" | tar -tf - >/dev/null
    mkdir -p -- "$hub_root/$tool"
    if ! { cp -- "$stage/publish.tar.age" "$dest.tmp" && mv -f -- "$dest.tmp" "$dest" &&
        cmp -s -- "$stage/publish.tar.age" "$dest"; }; then
        rm -f -- "$dest.tmp"
        warn "$tool: could not write $dest; the next run tries again"
        return 1
    fi
    printf '%s\n' "$digest" >"$state_dir/published"
    log "$tool: published this device's snapshot to $dest"
}

# summary <count> <what>: one line per tool, naming the other devices it merged with.
summary() {
    local others=() name
    for name in "${peer_device[@]}"; do
        if [[ "$name" != "$device" ]]; then
            others+=("$name")
        fi
    done
    if (( ${#others[@]} > 0 )); then
        log "$tool: $1 $2, merged with ${others[*]}"
    else
        log "$tool: $1 $2; no other device has published yet"
    fi
}

# --- entries -----------------------------------------------------------------------------------------

# entries_scan: local_hash/local_time for each entry directly inside the tool's folder.
entries_scan() {
    local path name digest mtime
    local_hash=()
    local_time=()
    [[ -d "$tool_dir" ]] || return 0
    while IFS= read -r -d '' path; do
        name="${path##*/}"
        if [[ "$name" == .secrets-sync.* ]]; then
            # A run that stopped half way leaves these; the lock means none is in use.
            $dry_run || rm -rf -- "$path"
            continue
        fi
        if ! entry_name_ok "$name"; then
            warn "$tool: skipping an entry whose name the sync cannot carry: $path"
            continue
        fi
        if [[ -L "$path" ]]; then
            warn "$tool: skipping $name, a symlink (only files and folders sync)"
            continue
        elif [[ -f "$path" ]]; then
            digest="$(file_digest "$path")"
            mtime="$(stat -c %Y -- "$path")"
        elif [[ -d "$path" ]]; then
            if [[ -n "$(find "$path" -mindepth 1 ! -type f ! -type d -print -quit)" ]]; then
                warn "$tool: skipping $name, which holds a symlink or a special file"
                continue
            fi
            digest="$(tree_digest "$path")"
            mtime="$(tree_mtime "$path")"
        else
            warn "$tool: skipping $name, neither a file nor a folder"
            continue
        fi
        if (( mtime > now )); then
            mtime="$now"
        fi
        local_hash[$name]="$digest"
        local_time[$name]="$mtime"
    done < <(find "$tool_dir" -mindepth 1 -maxdepth 1 -print0)
}

# entries_stage <name> <dest>: copies a local entry as it syncs -- a file without the lines it keeps
# to itself -- and sets staged_digest to the copy's digest.
entries_stage() {
    local src="$tool_dir/$1"
    if [[ -f "$src" && ! -L "$src" ]]; then
        if [[ -n "$local_lines" ]]; then
            { LC_ALL=C grep -a -v -E -- "$local_lines" "$src" || [[ $? -eq 1 ]]; } >"$2"
            chmod --reference="$src" -- "$2"
            touch -r "$src" -- "$2"
        else
            cp -p -- "$src" "$2"
        fi
        staged_digest="$(sha256sum <"$2" | cut -c1-64)"
    elif [[ -d "$src" && ! -L "$src" ]]; then
        cp -a -- "$src" "$2"
        if [[ -n "$(find "$2" -mindepth 1 ! -type f ! -type d -print -quit)" ]]; then
            return 1
        fi
        staged_digest="$(tree_digest "$2")"
    else
        return 1
    fi
}

# entries_take <name>: puts the winning copy of an entry, from the snapshot that holds it, in place
# of the local one. A file keeps its own local lines. It runs as a condition, where set -e is off, so
# every step checks for itself.
entries_take() {
    local name="$1" index="${win_source[$1]}" target="$tool_dir/$1" got digest="" keep mtime
    local new="$tool_dir/.secrets-sync.$1.new" old="$tool_dir/.secrets-sync.$1.old"
    { rm -rf -- "$stage/take" && mkdir -p -- "$stage/take"; } || return 1
    if ! tar -x -p --no-same-owner -C "$stage/take" -f "${peer_tar[$index]}" -- "data/$name" 2>/dev/null; then
        warn "$tool: ${peer_device[$index]}'s snapshot does not hold $name; leaving it"
        return 1
    fi
    got="$stage/take/data/$name"
    if [[ -f "$got" && ! -L "$got" ]]; then
        digest="$(sha256sum <"$got" | cut -c1-64)" || return 1
    elif [[ -d "$got" && ! -L "$got" ]]; then
        digest="$(tree_digest "$got")" || return 1
    fi
    if [[ "$digest" != "${win_hash[$name]}" ]]; then
        warn "$tool: $name from ${peer_device[$index]} does not match its manifest; leaving it"
        return 1
    fi
    if [[ -e "$target" && -n "${changed[$name]:-}" ]]; then
        conflict_keep "$target" "$name" "${peer_device[$index]}" || return 1
    fi
    { mkdir -p -- "$tool_dir" && rm -rf -- "$new" "$old" && cp -a -- "$got" "$new"; } || return 1
    if [[ -f "$new" && -n "$local_lines" && -f "$target" ]]; then
        keep="$stage/keep"
        { LC_ALL=C grep -a -E -- "$local_lines" "$target" || [[ $? -eq 1 ]]; } >"$keep" || return 1
        if [[ -s "$keep" ]]; then
            mtime="$(stat -c %Y -- "$new")" || return 1
            if [[ -s "$new" && "$(tail -c 1 -- "$new" | od -An -tx1 | tr -d ' \n')" != 0a ]]; then
                printf '\n' >>"$new" || return 1
            fi
            { cat -- "$keep" >>"$new" && touch -d "@$mtime" -- "$new"; } || return 1
        fi
    fi
    if [[ -f "$new" && -f "$target" && ! -L "$target" ]]; then
        mv -f -T -- "$new" "$target" || return 1
    else
        if [[ -e "$target" || -L "$target" ]]; then
            mv -T -- "$target" "$old" || return 1
        fi
        if ! mv -T -- "$new" "$target"; then
            if [[ -e "$old" ]]; then
                mv -T -- "$old" "$target"
            fi
            return 1
        fi
        rm -rf -- "$old"
    fi
    log "$tool: took $name from ${peer_device[$index]}"
}

# rival_keep <name>: keeps another device's change to an entry that this device's newer change
# beat, so a concurrent edit is never lost without a copy. It runs as a condition too.
rival_keep() {
    local name="$1" index="${rival[$1]}" dest
    dest="$state_root/conflicts/$tool/$(date -u -d "@$now" +%Y%m%dT%H%M%SZ)" || return 1
    { rm -rf -- "$stage/rival" && mkdir -p -- "$stage/rival" "$dest"; } || return 1
    if ! tar -x -p --no-same-owner -C "$stage/rival" -f "${peer_tar[$index]}" -- "data/$name" 2>/dev/null; then
        warn "$tool: could not keep ${peer_device[$index]}'s change to $name, which this device's newer one beat"
        return 1
    fi
    cp -a -- "$stage/rival/data/$name" "$dest/$name.${peer_device[$index]}" || return 1
    warn "$tool: this device's change to $name beat a concurrent one from ${peer_device[$index]}; kept theirs in $dest/$name.${peer_device[$index]}"
}

# entries_remove <name>: deletes a local entry another device deleted. It runs as a condition too.
entries_remove() {
    local name="$1" index="${win_source[$1]}" from="another device" old="$tool_dir/.secrets-sync.$1.old"
    if [[ "$index" != self ]]; then
        from="${peer_device[$index]}"
    fi
    if [[ -n "${changed[$name]:-}" ]]; then
        conflict_keep "$tool_dir/$name" "$name" "$from" || return 1
    fi
    { rm -rf -- "$old" && mv -T -- "$tool_dir/$name" "$old" && rm -rf -- "$old"; } || return 1
    log "$tool: deleted $name, as $from did"
}

sync_entries() {
    local name state time hash index deletes=0 holds=0 failures=0 records="$stage/records"
    local -a names=()
    local -A seen=() rival=()
    entries_scan
    base_load
    if [[ ! -d "$tool_dir" ]] && base_has_live && ! $allow_deletes; then
        warn "$tool: $tool_dir is gone, though it held entries at the last sync; not deleting them everywhere"
        warn "$tool: put it back (secrets-restore) and run again, or run 'secrets-sync --allow-deletes' if it was meant"
        return 1
    fi

    # This device's records: an entry unchanged since the base keeps its record; a changed one is new
    # as of its modification time; one in the base and gone from the folder is a delete.
    changed=()
    for name in "${!local_hash[@]}" "${!base_state[@]}"; do
        [[ -z "${seen[$name]:-}" ]] || continue
        seen[$name]=1
        if [[ -n "${local_hash[$name]+set}" ]]; then
            if [[ "${base_state[$name]:-}" == live && "${base_hash[$name]}" == "${local_hash[$name]}" ]]; then
                offer "$name" live "${base_time[$name]}" "${local_hash[$name]}" self
            else
                offer "$name" live "${local_time[$name]}" "${local_hash[$name]}" self
                changed[$name]=1
            fi
        elif [[ "${base_state[$name]:-}" == live ]]; then
            offer "$name" dead "$(dead_time)" - self
            changed[$name]=1
        elif [[ "${base_state[$name]:-}" == dead ]]; then
            offer "$name" dead "${base_time[$name]}" - self
        fi
    done

    # The other devices' records. A copy another device changed since this one last synced, of an
    # entry this one changed too, is a rival: when this device's change wins, the rival is kept.
    peers_read
    for index in "${!peer_tar[@]}"; do
        while IFS=$'\t' read -r state time hash name; do
            offer "$name" "$state" "$time" "$hash" "$index"
            if [[ "$state" == live && -n "${changed[$name]:-}" && "$hash" != "${base_hash[$name]:-}" &&
                "$hash" != "${local_hash[$name]:-}" ]] && (( time > ${base_time[$name]:-0} )); then
                rival[$name]="$index"
            fi
        done < <(peer_records "$index")
    done

    # The guard counts the deletes made here. One another device made passed that device's guard, and
    # counting it again would make every device repeat --allow-deletes for it.
    for name in "${!seen[@]}"; do
        if [[ -n "${local_hash[$name]+set}" || "${base_state[$name]:-}" == live ]]; then
            holds=$((holds + 1))
        fi
        if [[ -z "${local_hash[$name]+set}" && "${base_state[$name]:-}" == live ]]; then
            deletes=$((deletes + 1))
        fi
    done
    delete_guard "$deletes" "$holds" entries || return 2

    # Apply the winners. A failed entry keeps its old record in the base, so the next run tries again.
    mapfile -t names < <(win_keys)
    for name in "${names[@]}"; do
        if [[ -n "${rival[$name]:-}" && "${win_source[$name]}" == self ]] && ! $dry_run; then
            rival_keep "$name" || failures=$((failures + 1))
        fi
        if [[ "${win_state[$name]}" == live ]]; then
            [[ "${local_hash[$name]:-}" != "${win_hash[$name]}" ]] || continue
            if $dry_run; then
                log "$tool: would take $name from ${peer_device[${win_source[$name]}]}"
            elif ! entries_take "$name"; then
                failures=$((failures + 1))
            fi
        elif [[ -n "${local_hash[$name]+set}" ]]; then
            if $dry_run; then
                log "$tool: would delete $name"
            elif ! entries_remove "$name"; then
                failures=$((failures + 1))
            fi
        fi
    done
    if $dry_run; then
        return 0
    fi

    # The new base, and what to publish, from what is on disk now: an entry that matches its winner
    # takes the winner's record, a delete holds where the entry is gone, and anything else keeps its
    # old record and is not published.
    pub="$stage/publish"
    rm -rf -- "$pub"
    mkdir -p -- "$pub/data"
    : >"$records"
    : >"$stage/base-records"
    for name in "${names[@]}"; do
        if [[ "${win_state[$name]}" == live ]]; then
            if [[ -e "$tool_dir/$name" ]] && entries_stage "$name" "$pub/data/$name" &&
                [[ "$staged_digest" == "${win_hash[$name]}" ]]; then
                printf 'r\tlive\t%s\t%s\t%s\n' "${win_time[$name]}" "${win_hash[$name]}" "$name" >>"$records"
                continue
            fi
            rm -rf -- "$pub/data/$name"
        elif [[ ! -e "$tool_dir/$name" && ! -L "$tool_dir/$name" ]]; then
            printf 'r\tdead\t%s\t-\t%s\n' "${win_time[$name]}" "$name" >>"$records"
            continue
        fi
        if [[ -n "${base_state[$name]+set}" ]]; then
            printf 'r\t%s\t%s\t%s\t%s\n' "${base_state[$name]}" "${base_time[$name]}" "${base_hash[$name]}" "$name" >>"$stage/base-records"
        fi
    done
    cat -- "$records" >>"$stage/base-records"
    LC_ALL=C sort -t $'\t' -k 5 -o "$stage/base-records" "$stage/base-records"
    base_write "$stage/base-records"

    publish "$records"
    summary "$(grep -c $'^r\tlive\t' "$records" || true)" entries
    (( failures == 0 ))
}

# --- lines ---------------------------------------------------------------------------------------------

# line_digest <line>: the SHA-256 of a line, without its newline.
line_digest() {
    printf '%s' "$1" | sha256sum | cut -c1-64
}

sync_lines() {
    local file="$tool_dir" state time hash key index removes=0 holds mtime=0
    local records="$stage/records" texts="$stage/texts" line
    local new
    new="$(dirname -- "$tool_dir")/.secrets-sync.$(basename -- "$tool_dir").new"
    local -a keys=()
    local -A text=()
    # A run that stopped half way leaves this; the lock means none is in use.
    $dry_run || rm -f -- "$new"
    base_load
    if [[ ! -f "$file" ]] && base_has_live_lines && ! $allow_deletes; then
        warn "$tool: $file is gone, though it held lines at the last sync; not deleting them everywhere"
        warn "$tool: put it back (secrets-restore) and run again, or run 'secrets-sync --allow-deletes' if it was meant"
        return 1
    fi
    if [[ -e "$file" && ! -f "$file" ]] || [[ -L "$file" ]]; then
        warn "$tool: $file is not a regular file; skipping it"
        return 1
    fi

    # The sets, one line each, in byte order: this device's file, and the base it last synced.
    if [[ -f "$file" ]]; then
        LC_ALL=C sort -u -- "$file" >"$stage/local.set"
        mtime="$(stat -c %Y -- "$file")"
    else
        : >"$stage/local.set"
    fi
    if [[ -f "$state_dir/base.lines" ]]; then
        LC_ALL=C sort -u -- "$state_dir/base.lines" >"$stage/base.set"
    else
        : >"$stage/base.set"
    fi
    if [[ -f "$state_dir/base.texts" ]]; then
        while IFS= read -r line; do
            text[${line%%$'\t'*}]="${line#*$'\t'}"
        done <"$state_dir/base.texts"
    fi

    # Records exist only for lines that were deleted somewhere, or added back after: every other line
    # is simply live. A line in the base and gone from the file is a delete made here.
    for key in "${!base_state[@]}"; do
        if [[ -n "${text[$key]+set}" ]]; then
            offer "$key" "${base_state[$key]}" "${base_time[$key]}" - self
        fi
    done
    while IFS= read -r line; do
        key="$(line_digest "$line")"
        text[$key]="$line"
        offer "$key" dead "$(dead_time)" - self
    done < <(LC_ALL=C comm -23 "$stage/base.set" "$stage/local.set")

    # The other devices: their records, the texts of those records, and their lines.
    peers_read
    : >"$stage/peers.set"
    for index in "${!peer_tar[@]}"; do
        rm -rf -- "$stage/take"
        mkdir -p -- "$stage/take"
        if ! tar -x -C "$stage/take" -f "${peer_tar[$index]}" -- data/lines data/texts 2>/dev/null ||
            [[ "$(sha256sum <"$stage/take/data/lines" | cut -c1-64)" != "$(manifest_field "${peer_manifest[$index]}" content)" ]]; then
            warn "$tool: ${peer_device[$index]}'s lines do not match its manifest; skipping them"
            continue
        fi
        while IFS= read -r line; do
            key="${line%%$'\t'*}"
            if [[ "$key" =~ ^[0-9a-f]{64}$ && -z "${text[$key]+set}" &&
                "$(line_digest "${line#*$'\t'}")" == "$key" ]]; then
                text[$key]="${line#*$'\t'}"
            fi
        done <"$stage/take/data/texts"
        while IFS=$'\t' read -r state time hash key; do
            if [[ -n "${text[$key]+set}" ]]; then
                offer "$key" "$state" "$time" - "$index"
            fi
        done < <(peer_records "$index")
        cat -- "$stage/take/data/lines" >>"$stage/peers.set"
    done

    # A line added here since the base comes back when it was written after the delete that holds
    # it: the file's modification time stands for when.
    for key in "${!win_state[@]}"; do
        if [[ "${win_state[$key]}" == dead ]] && (( mtime > ${win_time[$key]} )) &&
            grep -qxF -- "${text[$key]}" "$stage/local.set" && ! grep -qxF -- "${text[$key]}" "$stage/base.set"; then
            offer "$key" live "$mtime" - self
        fi
    done

    # The merged set: every device's lines, without those whose newest record is a delete.
    : >"$stage/dead.set"
    for key in "${!win_state[@]}"; do
        if [[ "${win_state[$key]}" == dead ]]; then
            printf '%s\n' "${text[$key]}" >>"$stage/dead.set"
        fi
    done
    LC_ALL=C sort -u -o "$stage/dead.set" "$stage/dead.set"
    LC_ALL=C sort -u "$stage/local.set" "$stage/peers.set" | LC_ALL=C comm -23 - "$stage/dead.set" >"$stage/merged.set"

    # The guard counts the lines deleted here, as for entries.
    holds="$(LC_ALL=C sort -u "$stage/base.set" "$stage/local.set" | wc -l)"
    removes="$(LC_ALL=C comm -23 "$stage/base.set" "$stage/local.set" | wc -l)"
    delete_guard "$removes" "$holds" lines || return 2

    local added removed
    added="$(LC_ALL=C comm -13 "$stage/local.set" "$stage/merged.set" | wc -l)"
    removed="$(LC_ALL=C comm -23 "$stage/local.set" "$stage/merged.set" | wc -l)"
    if $dry_run; then
        if (( added > 0 || removed > 0 )); then
            log "$tool: would merge the other devices' lines into $file: $added added, $removed deleted"
        fi
        return 0
    fi

    # Rewrite the file only when its set changes: its own lines keep their order, removed ones go, and
    # new ones follow in byte order.
    if (( added > 0 || removed > 0 )); then
        mkdir -p -- "$(dirname -- "$file")"
        {
            if [[ -f "$file" ]]; then
                LC_ALL=C awk 'NR == FNR { keep[$0] = 1; next } ($0 in keep)' "$stage/merged.set" "$file"
            fi
            LC_ALL=C comm -13 "$stage/local.set" "$stage/merged.set"
        } >"$new"
        if [[ -f "$file" ]]; then
            chmod --reference="$file" -- "$new"
        fi
        mv -f -T -- "$new" "$file"
        log "$tool: merged the other devices' lines into $file: $added added, $removed deleted"
    fi

    # The new base and what to publish: the merged set, and the records still remembered, with their
    # texts.
    command cp -- "$stage/merged.set" "$state_dir/base.lines.tmp"
    mv -f -- "$state_dir/base.lines.tmp" "$state_dir/base.lines"
    : >"$records"
    : >"$texts"
    mapfile -t keys < <(win_keys)
    for key in "${keys[@]}"; do
        if [[ "${win_state[$key]}" == live ]] && (( ${win_time[$key]} < cutoff )); then
            continue
        fi
        printf 'r\t%s\t%s\t-\t%s\n' "${win_state[$key]}" "${win_time[$key]}" "$key" >>"$records"
        printf '%s\t%s\n' "$key" "${text[$key]}" >>"$texts"
    done
    base_write "$records"
    command cp -- "$texts" "$state_dir/base.texts"

    pub="$stage/publish"
    rm -rf -- "$pub"
    mkdir -p -- "$pub/data"
    command cp -- "$stage/merged.set" "$pub/data/lines"
    command cp -- "$texts" "$pub/data/texts"
    publish "$records" "$(sha256sum <"$pub/data/lines" | cut -c1-64)"
    summary "$(wc -l <"$stage/merged.set")" lines
}

base_has_live_lines() {
    [[ -s "$state_dir/base.lines" ]]
}

# --- the tools -----------------------------------------------------------------------------------------

# sync_tool <index>: one tool, in a subshell of its own, so that a failure in one leaves the others
# to sync. Exits 0 when in sync, 2 when the delete guard stopped it, 3 when a snapshot did not
# authenticate, and 1 otherwise.
sync_tool() {
    tool="${tool_names[$1]}"
    tool_dir="$root/${tool_paths[$1]}"
    merge="${tool_merges[$1]}"
    local_lines="${tool_local_lines[$1]}"
    state_dir="$state_root/$tool"
    stage="$stage/$tool"
    suspicious=0
    declare -A win_state=() win_time=() win_hash=() win_source=() changed=()
    declare -A local_hash=() local_time=() base_state=() base_time=() base_hash=()
    peer_tar=()
    peer_device=()
    peer_manifest=()

    # A device syncs a tool whose folder it has (~/.kube for its kubeconfigs), or one it synced
    # before: a vanished folder must not read as deleting everything.
    if [[ ! -d "$(dirname -- "$tool_dir")" && ! -f "$state_dir/base" ]]; then
        log "$tool: $(dirname -- "$tool_dir") does not exist here, so it is not synced"
        return 0
    fi
    mkdir -p -- "$stage"
    $dry_run || mkdir -p -- "$state_dir"
    "sync_$merge"
    if (( suspicious > 0 )); then
        return 3
    fi
}

statuses=0
for index in "${!tool_names[@]}"; do
    if [[ -n "$only_tools" && " $only_tools " != *" ${tool_names[$index]} "* ]]; then
        continue
    fi
    set +e
    (
        set -e
        sync_tool "$index"
    )
    status=$?
    set -e
    case "$status" in
        0) ;;
        2) statuses=$((statuses + 1)) ;;
        3) warn "${tool_names[$index]}: a snapshot in the hub did not authenticate; see above"; statuses=$((statuses + 1)) ;;
        *) warn "${tool_names[$index]}: the sync failed (exit $status); the next run tries again"; statuses=$((statuses + 1)) ;;
    esac
done

if (( statuses > 0 )); then
    exit 1
fi
log "done; the hub is $hub_root"
