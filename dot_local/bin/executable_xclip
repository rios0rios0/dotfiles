#!/data/data/com.termux/files/usr/bin/bash
# xclip(1) shim for Termux, so Claude Code's Ctrl+V can attach images.
#
# Termux has no X11/Wayland clipboard, and Android's clipboard cannot hand a
# bitmap to another app's sandbox. Claude Code reads clipboard images purely by
# shelling out to xclip, so this script answers the two invocations it makes:
#
#   xclip -selection clipboard -t TARGETS   -o     -> list available types
#   xclip -selection clipboard -t image/png -o     -> write image bytes to stdout
#
# The "clipboard image" is resolved, in order, from:
#   1. $CLAUDE_CLIPBOARD_IMAGE                (explicit override)
#   2. a file staged by `clipshot <file>`     (any image, shared or downloaded)
#   3. the newest image in the watched folders, if it is fresher than
#      $CLAUDE_CLIPBOARD_MAX_AGE seconds (default 600)
#
# An image is reported once and then marked consumed, so a second Ctrl+V does
# not re-attach it and text paste still works. Set CLAUDE_CLIPBOARD_REPEAT=1 to
# keep re-offering the same image.
#
# Text targets fall through to termux-clipboard-get when Termux:API is present.
#
# See .docs/termux-clipboard-images.md for the discovery and design decisions.

set -u

CLIPBOARD_LIB="${CLAUDE_CLIPBOARD_LIB:-$HOME/.local/lib/claude-clipboard.sh}"
if [ ! -r "$CLIPBOARD_LIB" ]; then
    echo "[xclip] ERROR: missing $CLIPBOARD_LIB (run \`chezmoi apply\`)" >&2
    exit 1
fi
# shellcheck source=/dev/null
. "$CLIPBOARD_LIB"

MAX_AGE="${CLAUDE_CLIPBOARD_MAX_AGE:-600}"

mode="in"
target=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o|-out|-output)          mode="out" ;;
        -i|-in|-input)            mode="in" ;;
        -t|-target)               target="${2:-}"; shift ;;
        -selection|-sel|-s)       shift ;;
        -d|-display|-l|-loops)    shift ;;
        -h|-help|--help)          echo "xclip shim (Termux): see $0" >&2; exit 0 ;;
    esac
    shift
done

# Echo "<mtime> <path>" for the image to serve, or return 1.
resolve_image() {
    local path line now mtime
    if [ -n "${CLAUDE_CLIPBOARD_IMAGE:-}" ] && [ -f "$CLAUDE_CLIPBOARD_IMAGE" ]; then
        printf '%s %s\n' "$(stat -c '%Y' -- "$CLAUDE_CLIPBOARD_IMAGE")" "$CLAUDE_CLIPBOARD_IMAGE"
        return 0
    fi
    if [ -f "$CLAUDE_CLIPBOARD_STAGED_FILE" ]; then
        path=$(cat -- "$CLAUDE_CLIPBOARD_STAGED_FILE")
        if [ -n "$path" ] && [ -f "$path" ]; then
            printf '%s %s\n' "$(stat -c '%Y' -- "$path")" "$path"
            return 0
        fi
    fi
    # Only the unstaged, automatic pick is age-bounded: an explicit override or
    # a deliberate `clipshot` is a statement of intent, whatever the mtime.
    line=$(clipboard_newest_image) || return 1
    mtime="${line%% *}"
    now=$(date +%s)
    [ $((now - mtime)) -gt "$MAX_AGE" ] && return 1
    printf '%s\n' "$line"
}

is_consumed() {
    [ -n "${CLAUDE_CLIPBOARD_REPEAT:-}" ] && return 1
    [ -f "$CLAUDE_CLIPBOARD_CONSUMED_FILE" ] || return 1
    [ "$(cat -- "$CLAUDE_CLIPBOARD_CONSUMED_FILE" 2>/dev/null)" = "$1" ]
}

mark_consumed() {
    mkdir -p "$CLAUDE_CLIPBOARD_CACHE_DIR" 2>/dev/null || return 0
    printf '%s' "$1" >"$CLAUDE_CLIPBOARD_CONSUMED_FILE" 2>/dev/null || true
    rm -f -- "$CLAUDE_CLIPBOARD_STAGED_FILE" 2>/dev/null || true
}

emit_text() {
    command -v termux-clipboard-get >/dev/null 2>&1 || return 1
    local text
    text=$(termux-clipboard-get 2>/dev/null) || return 1
    [ -z "$text" ] && return 1
    printf '%s' "$text"
}

if [ "$mode" = "in" ]; then
    # Copy direction: hand it to Termux:API when it is text, otherwise drop it.
    if command -v termux-clipboard-set >/dev/null 2>&1; then
        termux-clipboard-set && exit 0
    fi
    exit 1
fi

case "$target" in
    TARGETS)
        record=$(resolve_image) && ! is_consumed "$record" && {
            printf 'TIMESTAMP\nTARGETS\nimage/png\n'
            exit 0
        }
        if emit_text >/dev/null 2>&1; then
            printf 'TIMESTAMP\nTARGETS\nUTF8_STRING\ntext/plain\n'
            exit 0
        fi
        exit 1
        ;;
    image/*)
        record=$(resolve_image) || exit 1
        is_consumed "$record" && exit 1
        path="${record#* }"
        cat -- "$path" || exit 1
        mark_consumed "$record"
        exit 0
        ;;
    ""|text/*|UTF8_STRING|STRING)
        emit_text || exit 1
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
