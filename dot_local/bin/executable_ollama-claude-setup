#!/usr/bin/env bash
set -euo pipefail

readonly DEFAULT_MODEL='qwen3.8:27b'
readonly DEFAULT_CONTEXT_TOKENS=65536
readonly OLLAMA_INSTALLER_URL='https://ollama.com/install.sh'
readonly SYSTEMD_DROP_IN='/etc/systemd/system/ollama.service.d/claude-code.conf'

model="$DEFAULT_MODEL"
context_tokens="$DEFAULT_CONTEXT_TOKENS"

usage() {
    cat <<'EOF'
Usage: ollama-claude-setup [--model MODEL] [--context TOKENS]

Installs Ollama when missing, configures its WSL service context, and pulls a model.
Defaults: qwen3.8:27b with a 65536-token context.
EOF
}

fail() {
    printf '[ollama-claude-setup] %s\n' "$1" >&2
    exit 1
}

run_as_root() {
    if ((EUID == 0)); then
        "$@"
    else
        sudo "$@"
    fi
}

install_ollama() {
    local installer="$work_dir/install-ollama.sh"

    command -v curl >/dev/null 2>&1 || fail 'curl is required to install Ollama'
    printf '[ollama-claude-setup] downloading the official Ollama installer\n' >&2
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        "$OLLAMA_INSTALLER_URL" --output "$installer"
    sh "$installer"
}

configure_service() {
    local override="$work_dir/claude-code.conf"

    [[ -d /run/systemd/system ]] || fail 'systemd is not active; enable systemd in WSL before setup'
    systemctl cat ollama.service >/dev/null 2>&1 || fail 'the Ollama systemd service was not installed'

    printf '[Service]\nEnvironment="OLLAMA_CONTEXT_LENGTH=%s"\n' "$context_tokens" >"$override"
    run_as_root install -D -m 0644 "$override" "$SYSTEMD_DROP_IN"
    run_as_root systemctl daemon-reload
    run_as_root systemctl enable ollama.service >/dev/null
    run_as_root systemctl restart ollama.service
}

while (($# > 0)); do
    case "$1" in
        --model)
            (($# > 1)) || fail '--model requires a model name'
            model="$2"
            shift 2
            ;;
        --context)
            (($# > 1)) || fail '--context requires a token count'
            context_tokens="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "unknown argument: $1"
            ;;
    esac
done

[[ "$model" =~ ^[[:alnum:]_.:/-]+$ ]] || fail 'model names may contain only letters, numbers, dots, underscores, colons, slashes, and hyphens'
[[ "$context_tokens" =~ ^[0-9]+$ ]] || fail 'context must be a number between 8192 and 262144'
((10#$context_tokens >= 8192 && 10#$context_tokens <= 262144)) || fail 'context must be between 8192 and 262144 tokens'
grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease || fail 'run this setup from WSL'

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT

if command -v nvidia-smi >/dev/null 2>&1; then
    if ! nvidia-smi --query-gpu=name,memory.total --format=csv,noheader; then
        printf '[ollama-claude-setup] warning: WSL could not query NVIDIA GPU memory\n' >&2
    fi
else
    printf '[ollama-claude-setup] warning: nvidia-smi is unavailable; Ollama may use the CPU\n' >&2
fi

if ! command -v ollama >/dev/null 2>&1; then
    install_ollama
fi
command -v ollama >/dev/null 2>&1 || fail 'Ollama installation did not provide the ollama command'

configure_service
export OLLAMA_HOST='http://127.0.0.1:11434'

ready=false
for attempt in {1..30}; do
    if curl --fail --silent --connect-timeout 1 --max-time 2 \
        "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 1
done
[[ "$ready" == true ]] || fail 'Ollama did not become available at http://127.0.0.1:11434'

printf '[ollama-claude-setup] pulling %s with %s-token context\n' "$model" "$context_tokens" >&2
ollama pull "$model"
ollama show "$model" >/dev/null

printf '[ollama-claude-setup] setup complete; start local sessions with: claude-local\n' >&2
