{{- $omni := includeTemplate "lib-omniroute.tmpl" . | fromJson -}}
#!/bin/bash

# claude-omni-task: runs one task through claude-omni, unattended, and returns an audit of the run.
# See .docs/omniroute-local.md, "Delegating a task".
#
#   claude-omni-task [-m ID] BRIEF_FILE
#
# Without -m, the run takes the first GPU in omniroute.taskGpus that is free and serving. Free means
# no other claude-omni-task holds its lock: a GPU serves one request at a time, so a second run would
# only queue behind the first until both time out. Serving means `claude-omni --check` passes: the
# server answers, and on another machine it holds the model at this machine's window. -m names any
# model claude-omni can start, a cloud one included, and then every file the model reads goes to
# that provider; the audit says so.
#
# The model works as the caller's own session does, with every permission check off: nothing is
# prompted and nothing is refused, so it can run whatever the task needs. Nobody watches it
# either, so instead of restricting the run, this hands all of it back to whoever asked:
#   - every action the model took, in order, with its result, read from the run's event stream;
#   - the change it made, measured between snapshots of the working tree taken before and after
#     the run in a scratch index -- untracked files included, the caller's own index untouched --
#     so changes that were already there are never attributed to it;
#   - one command that undoes exactly that change;
#   - the full transcript, which Claude Code keeps under claude-omni's profile.
# The audit is printed in short and saved in full under ~/.claude-omni/audits.
#
# An audit cannot take back what left the working tree: a commit, a push, a request to a server,
# a write somewhere else. Those show up in the action list and as a moved HEAD, and nowhere else.

set -euo pipefail

prefix="claude-omni-task"
launcher="claude-omni"
max_turns=40
# A little under the 10 minutes a calling agent's shell allows, so that the audit is still
# written when a run is cut short.
time_limit=570
config_dir="${CLAUDE_OMNI_CONFIG_DIR:-$HOME/.claude-omni}"
gpu_model={{ $omni.gpuModel | quote }}
task_gpus=({{ range $omni.taskGpus }}{{ . | quote }} {{ end }})
gpu_prefixes=({{ range $gpu, $_ := $omni.gpus }}{{ $gpu | quote }} {{ end }})

usage() {
    echo "usage: $prefix [-m ID] BRIEF_FILE" >&2
    exit 2
}

die() {
    echo "[$prefix] ERROR: $1" >&2
    exit "${2:-1}"
}

model=""
if [[ "${1:-}" == "-m" || "${1:-}" == "--model" ]]; then
    [[ $# -ge 2 ]] || usage
    model="$2"
    shift 2
fi
[[ $# -eq 1 && "$1" != -* ]] || usage
brief="$1"
[[ -r "$brief" ]] || die "cannot read the brief $brief" 2

for tool in "$launcher" jq git flock; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"
done

# The caller's effort level is the caller's; the run takes the one omniroute.yaml sets for its model.
unset CLAUDE_EFFORT

is_gpu() {
    local gpu
    for gpu in "${gpu_prefixes[@]}"; do
        [[ "$1" == "$gpu" ]] && return 0
    done
    return 1
}

# Holds the GPU's lock until this process exits; fails when another run holds it.
lock_gpu() {
    mkdir -p "$config_dir/locks"
    exec {lock_fd}>"$config_dir/locks/$1.lock"
    flock -n "$lock_fd" && return 0
    exec {lock_fd}>&-
    return 1
}

checks="$(mktemp)"
trap 'rm -f "$checks"' EXIT
if [[ -z "$model" ]]; then
    for gpu in "${task_gpus[@]}"; do
        if ! lock_gpu "$gpu"; then
            echo "[$prefix] $gpu is running another task" >>"$checks"
            continue
        fi
        if check="$("$launcher" --check -m "$gpu/$gpu_model" 2>&1 >/dev/null)"; then
            printf '%s\n' "$check" >>"$checks"
            model="$gpu/$gpu_model"
            break
        fi
        echo "[$prefix] skipped $gpu: $(tail -1 <<<"$check" | sed 's/^\[claude-omni\] \(ERROR: \)\{0,1\}//')" >>"$checks"
        exec {lock_fd}>&-
    done
    if [[ -z "$model" ]]; then
        cat "$checks" >&2
        die "no GPU in omniroute.taskGpus is free and serving; name another model with -m"
    fi
elif is_gpu "${model%%/*}"; then
    lock_gpu "${model%%/*}" || die "${model%%/*} is running another task; wait for it, or name another model with -m"
fi
if is_gpu "${model%%/*}"; then
    where="the GPU behind ${model%%/*}"
else
    where="${model%%/*}, a cloud provider that receives every file the model reads"
fi

# Every action the model took, read from the stream-json events: one line each with $format
# "line", or one section each with "markdown", which adds the output of every command. Lines that
# are not JSON -- the last one, when a run is cut short -- are skipped.
# shellcheck disable=SC2016
actions_jq='
def text:
  if type == "array" then [.[] | select(.type? == "text") | .text] | join("\n")
  elif type == "string" then .
  else tojson end;
def clip($n): split("\n") | if length > $n then .[:$n] + ["[... \(length - $n) more lines]"] else . end | join("\n");
def one_line: gsub("[\r\n\t ]+"; " ") | if length > 140 then .[:137] + "..." else . end;
def first_line: [split("\n")[] | select(test("\\S"))][0] // "" | gsub("\\s+"; " ") | if length > 100 then .[:97] + "..." else . end;
def pad($width): tostring as $s | ([range($width - ($s | length))] | map(" ") | join("")) + $s;
def inside: $root != "" and startswith($root + "/");
def relative: if inside then .[($root | length) + 1:] else . end;
def subject:
  if .command then .command
  elif .file_path then
    (if $root != "" and (.file_path | inside | not) then "[outside the repository] " else "" end)
    + (.file_path | relative)
    + (if .content then " (\(.content | split("\n") | length) lines)" else "" end)
  elif .pattern then .pattern + (if .path then " in " + (.path | relative) else "" end)
  else tojson end;

[inputs | fromjson? // empty] as $events
| ([$events[] | select(.type == "user") | .message.content[]? | select(.type? == "tool_result")
    | {key: .tool_use_id, value: .}] | from_entries) as $results
| [$events[] | select(.type == "assistant") | .message.content[]? | select(.type? == "tool_use")]
| to_entries[]
| (.key + 1) as $n
| .value as $call
| $results[$call.id] as $result
| if $format == "line" then
    "\($n | pad(3)). \($call.name): \($call.input | subject | one_line) -> "
    + (if $result == null then "no result"
       elif $result.is_error then "error: \($result.content | text | first_line)"
       else "ok" end)
  else
    "### \($n). \($call.name): \(if $result == null then "no result" elif $result.is_error then "error" else "ok" end)\n\n"
    + "````\n\($call.input | subject)\n````\n"
    + (if $call.name == "Bash" and $result != null then "\n````\n\($result.content | text | clip(40))\n````\n" else "" end)
  end
'

# The working tree as a tree object, untracked files included. It is written through a copy of
# the index, so the caller's index -- staged changes and all -- is never touched.
snapshot() {
    local index status
    index="$(mktemp)"
    cp "$(git -C "$root" rev-parse --path-format=absolute --git-path index)" "$index" 2>/dev/null || rm -f "$index"
    GIT_INDEX_FILE="$index" git -C "$root" add --all >/dev/null 2>&1 &&
        GIT_INDEX_FILE="$index" git -C "$root" write-tree
    status=$?
    rm -f "$index"
    return "$status"
}

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
before=""
head_before=""
if [[ -n "$root" ]]; then
    before="$(snapshot)" || echo "[$prefix] WARN: could not snapshot the working tree; the change will not be measured" >&2
    head_before="$(git -C "$root" rev-parse --verify --quiet HEAD || true)"
fi

stream="$(mktemp)"
errors="$(mktemp)"
trap 'rm -f "$checks" "$stream" "$errors"' EXIT

started="$(date '+%Y-%m-%d %H:%M:%S')"
start=$SECONDS
code=0
timeout --kill-after=10 "$time_limit" "$launcher" -m "$model" -p --dangerously-skip-permissions \
    --output-format stream-json --verbose --max-turns "$max_turns" \
    <"$brief" >"$stream" 2>"$errors" || code=$?
elapsed=$(( SECONDS - start ))

after=""
head_after=""
if [[ -n "$before" ]]; then
    after="$(snapshot)" || after=""
    head_after="$(git -C "$root" rev-parse --verify --quiet HEAD || true)"
fi

result="$(jq -Rc 'fromjson? | select(.type == "result")' "$stream" 2>/dev/null | tail -1)"
session="$(jq -Rrn 'first(inputs | fromjson? | .session_id? // empty)' "$stream" 2>/dev/null || true)"
final="$(jq -r '.result // "(none)"' <<<"${result:-null}")"
transcript=""
if [[ -n "$session" && -d "$config_dir/projects" ]]; then
    transcript="$(find "$config_dir/projects" -name "$session.jsonl" -print -quit 2>/dev/null)"
fi
server="$(grep -hE '^\[(claude-omni|claude-omni-task)\]' "$checks" "$errors" | awk '!seen[$0]++' || true)"

if (( code == 124 || code == 137 )); then
    outcome="cut short after ${time_limit} s, with the model still working"
elif [[ -z "$result" ]]; then
    outcome="did not run (exit $code): $(grep -v '^\[claude-code:' "$errors" | tail -3 | tr '\n' ' ')"
elif [[ "$(jq -r '.is_error' <<<"$result")" == "true" ]]; then
    outcome="ended with an error ($(jq -r '.subtype' <<<"$result")) after $(jq -r '.num_turns' <<<"$result") turns, ${elapsed} s"
else
    outcome="completed in $(jq -r '.num_turns' <<<"$result") turns, ${elapsed} s"
fi

diff=""
undo=""
if [[ -z "$root" ]]; then
    change="not measured: not a Git repository"
elif [[ -z "$before" || -z "$after" ]]; then
    change="not measured: the working tree could not be snapshotted"
elif [[ "$before" == "$after" ]]; then
    change="none"
else
    change="$(git -C "$root" diff --shortstat "$before" "$after" | sed 's/^ *//')"
    printf -v diff 'git -C %q diff %s %s' "$root" "$before" "$after"
    printf -v undo 'git -C %q diff --binary %s %s | git -C %q apply -R' "$root" "$before" "$after" "$root"
fi
moved=""
if [[ -n "$before" && "$head_before" != "$head_after" ]]; then
    moved="HEAD moved from ${head_before:-nothing} to ${head_after:-nothing}: the run committed or switched branches"
fi

mkdir -p "$config_dir/audits"
audit="$config_dir/audits/$(date '+%Y%m%d-%H%M%S')-${session:0:8}.md"
{
    echo "# $prefix audit"
    echo
    echo "- started: $started, with \`$launcher\` in \`$PWD\`"
    echo "- model: \`$model\`, on $where"
    echo "- outcome: $outcome"
    echo "- transcript: \`${transcript:-not found}\`"
    [[ -z "$server" ]] || echo "- ${server//$'\n'/$'\n'- }"
    echo
    echo "## Brief"
    echo
    cat "$brief"
    echo
    echo "## The model's final message"
    echo
    echo "$final"
    echo
    echo "## Actions"
    echo
    jq -Rrn --arg root "$root" --arg format markdown "$actions_jq" "$stream" 2>/dev/null || true
    echo "## Change"
    echo
    echo "$change"
    if [[ -n "$undo" ]]; then
        echo
        echo '````'
        git -C "$root" diff --stat --summary "$before" "$after"
        echo '````'
        echo
        echo "Diff: \`$diff\`"
        echo
        echo "Undo: \`$undo\`"
    fi
    [[ -z "$moved" ]] || printf '\n%s\n' "$moved"
} >"$audit"

echo "[$prefix] full audit: $audit"
echo "model: $model, on $where"
echo "outcome: $outcome"
[[ -z "$server" ]] || echo "$server"
echo "actions:"
jq -Rrn --arg root "$root" --arg format line "$actions_jq" "$stream" 2>/dev/null | grep . || echo "  (none)"
echo "change: $change"
if [[ -n "$undo" ]]; then
    git -C "$root" diff --name-status "$before" "$after" | sed 's/^/  /'
    echo "diff: $diff"
    echo "undo: $undo"
fi
[[ -z "$moved" ]] || echo "$moved"
echo "transcript: ${transcript:-not found}"
echo "final message:"
echo "  ${final//$'\n'/$'\n'  }"

[[ -n "$result" ]]
