{{- $llm := includeTemplate "lib-local-llm.tmpl" . | fromJson -}}
#!/bin/bash

# tailscale-up: put this machine on the tailnet and keep it there. See CLAUDE.md, "Tailscale".
#
#   tailscale-up             starts tailscaled if it is off; logs in if needed, printing the login
#                            URL and waiting until it is used; and shares what this machine shares
#                            on the tailnet.
#   tailscale-up --no-login  what every interactive zsh runs. It brings a logged-in node back up
#                            after a `tailscale down`, and otherwise only says what is missing. It
#                            never waits, never asks for a password, and is silent when all is well.
#
# tailscaled is a system service (Tailscale's apt package, installed and enabled by
# run_onchange_after_linux-010-setup-tailscale.sh), so with systemd it starts with the machine --
# for WSL, with the first terminal -- and a logged-in node rejoins by itself. What it cannot do
# alone is done here:
#   - the first login, which needs a person at a browser;
#   - two preferences, set once with sudo, after which nothing here needs root again:
#       * --operator lets this user run `tailscale up` and `tailscale serve` without sudo, which is
#         what lets a new shell bring the node back up;
#       * --accept-dns=false keeps tailscaled away from /etc/resolv.conf. WSL writes that file
#         itself, and with no DNS manager running tailscaled would replace it with MagicDNS, so
#         every lookup would fail while tailscaled is down. Peers are reached by address instead:
#         `tailscale ip -4 <name>`, or `tailscale status --json`.
#   - sharing this machine's Ollama with the tailnet, when .chezmoidata/local-llm.yaml says so.

set -euo pipefail

prefix="tailscale"
prefs=(--operator="$USER" --accept-dns=false)

mode="${1:-}"
if [[ -n "$mode" && "$mode" != "--no-login" ]]; then
    echo "usage: tailscale-up [--no-login]" >&2
    exit 2
fi

# A shell's pass treats anything missing as a hint and lets the shell go on; asked for directly,
# it is an error.
stop() {
    if [[ "$mode" == "--no-login" ]]; then
        echo "[$prefix] $1" >&2
        exit 0
    fi
    echo "[$prefix] ERROR: $1" >&2
    exit 1
}

backend_state() {
    tailscale status --json 2>/dev/null | jq -r '.BackendState // empty' 2>/dev/null || true
}

command -v tailscale >/dev/null 2>&1 || stop "tailscale is not installed; run 'chezmoi apply'"

# --- a new shell's pass -------------------------------------------------------------------------

# WSL boots with the first terminal, so that terminal's zsh can get here before tailscaled answers;
# only a service that is switched off or has failed is worth a word.
daemon_down() {
    if systemctl is-enabled --quiet tailscaled 2>/dev/null && ! systemctl is-failed --quiet tailscaled 2>/dev/null; then
        exit 0
    fi
    stop "tailscaled is not running; run 'tailscale-up'"
}

on_tailnet() {
    exit 0
}

# A bare `tailscale up` only switches a logged-in node back on, which the operator may do; with
# any flag it would re-check every preference instead. Bounded, so an offline machine never holds
# up a prompt.
bring_up() {
    timeout 10 tailscale up >/dev/null 2>&1 || stop "could not bring this machine back onto the tailnet; run 'tailscale-up'"
}

logged_out() {
    stop "this machine is not logged in to the tailnet; run 'tailscale-up' to log in"
}

awaiting_approval() {
    stop "this machine waits for approval: https://login.tailscale.com/admin/machines"
}

if [[ "$mode" == "--no-login" ]]; then
    declare -A on_state=(
        [Running]=on_tailnet
        [Starting]=on_tailnet
        [Stopped]=bring_up
        [NeedsLogin]=logged_out
        [NoState]=logged_out
        [NeedsMachineAuth]=awaiting_approval
    )
    state="$(backend_state)"
    [[ -n "$state" ]] || daemon_down
    "${on_state[$state]:-on_tailnet}"
    exit 0
fi

# --- asked for directly -------------------------------------------------------------------------

state="$(backend_state)"
if [[ -z "$state" ]]; then
    sudo systemctl enable --now tailscaled
    for _ in $(seq 1 20); do
        state="$(backend_state)"
        [[ -n "$state" ]] && break
        sleep 0.5
    done
    [[ -n "$state" ]] || stop "tailscaled did not start; check 'systemctl status tailscaled'"
fi

# Logs in when needed, printing the URL and waiting until it is used, or switches a stopped node
# back on. The flags are spelled out because `tailscale up` refuses to drop a non-default
# preference it was not given; sudo, because this user may not be the operator yet.
if [[ "$state" != "Running" && "$state" != "Starting" ]]; then
    [[ "$state" == "Stopped" ]] || echo "[$prefix] log in with the URL below; this waits until you have" >&2
    sudo tailscale up "${prefs[@]}"
fi

# A node logged in some other way gets the same preferences. `tailscale set` changes only what it
# names, so preferences set by hand since survive.
tailscale set "${prefs[@]}" 2>/dev/null || sudo tailscale set "${prefs[@]}"
{{- if and $llm.enabled $llm.shareOnTailnet }}

# This machine's Ollama, on the tailnet's port 11434: the address claude-remote looks for. Serve
# keeps the forward in tailscaled's state, so it comes back with the service; it is only set here
# when it is missing.
if [[ "$(tailscale serve status --json 2>/dev/null | jq -r '.TCP["11434"].TCPForward // empty' 2>/dev/null)" != "127.0.0.1:11434" ]]; then
    tailscale serve --bg --tcp=11434 tcp://127.0.0.1:11434 >/dev/null 2>&1 ||
        sudo tailscale serve --bg --tcp=11434 tcp://127.0.0.1:11434 >/dev/null
    echo "[$prefix] sharing Ollama with the tailnet on port 11434" >&2
fi
{{- end }}

echo "[$prefix] on the tailnet as $(tailscale ip -4 2>/dev/null | head -1)" >&2
