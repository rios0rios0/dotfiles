#!/usr/bin/env bash
set -euo pipefail

model="${CLAUDE_LOCAL_MODEL:-qwen3.8:27b}"
context_tokens="${CLAUDE_LOCAL_CONTEXT_TOKENS:-65536}"
base_url="${CLAUDE_LOCAL_BASE_URL:-http://127.0.0.1:11434}"
base_url="${base_url%/}"
arguments=("$@")

for ((index = 0; index < ${#arguments[@]}; index++)); do
    case "${arguments[$index]}" in
        --model)
            if ((index + 1 < ${#arguments[@]})); then
                model="${arguments[$((index + 1))]}"
            fi
            break
            ;;
        --model=*)
            model="${arguments[$index]#--model=}"
            break
            ;;
    esac
done

if ! command -v claude >/dev/null 2>&1; then
    printf '[claude-local] Claude Code CLI was not found in PATH\n' >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    printf '[claude-local] curl is required to check the Ollama endpoint\n' >&2
    exit 1
fi

if ! curl --fail --silent --connect-timeout 2 --max-time 5 "${base_url}/api/tags" >/dev/null; then
    printf '[claude-local] Ollama is unavailable at %s\n' "$base_url" >&2
    printf '[claude-local] Start Ollama or check CLAUDE_LOCAL_BASE_URL\n' >&2
    exit 1
fi

unset ANTHROPIC_API_KEY
unset ANTHROPIC_AWS_API_KEY ANTHROPIC_AWS_BASE_URL ANTHROPIC_AWS_WORKSPACE_ID
unset ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_FOUNDRY_API_KEY ANTHROPIC_FOUNDRY_BASE_URL
unset ANTHROPIC_FOUNDRY_RESOURCE ANTHROPIC_VERTEX_BASE_URL
unset CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_FOUNDRY
unset CLAUDE_CODE_USE_VERTEX

export ANTHROPIC_AUTH_TOKEN=ollama
export ANTHROPIC_BASE_URL="$base_url"
export ANTHROPIC_MODEL="$model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
export ANTHROPIC_SMALL_FAST_MODEL="$model"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$context_tokens"
export CLAUDE_CODE_SUBAGENT_MODEL="$model"
export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1

exec claude "$@"
