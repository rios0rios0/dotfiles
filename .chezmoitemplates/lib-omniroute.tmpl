{{- /*
  Claude Code through OmniRoute, as JSON: .omniroute from .chezmoidata/omniroute.yaml with
  .omniroute.devices.<deviceName> laid over it, plus `gpuModel`, `gpuWindow` and `gpuKeepAlive`:
  local-llm.yaml's model, the window its server allocates, and how long it stays loaded.

  No model list is rendered here. claude-omni resolves its lineup from OmniRoute's /v1/models on
  every launch, so `gpus` above is all the repository needs to know about models: the prefix of
  each GPU's provider, which the launcher matches against the catalog.

  claude-omni and claude-omni-task read it the same way,
      includeTemplate "lib-omniroute.tmpl" . | fromJson
  so a GPU model's window is rendered from the same value as the Ollama unit's
  OLLAMA_CONTEXT_LENGTH, and the two cannot disagree.
*/ -}}
{{- /* deviceName is read with `get`, as lib-local-llm.tmpl does and for the same reason: a config
       that predates it must render with the defaults, so run_before_000-verify-chezmoi-config can
       report the stale config instead of the apply dying on a template error. */ -}}
{{- $omni := .omniroute -}}
{{- $deviceName := get . "deviceName" -}}
{{- $device := dict -}}
{{- if hasKey $omni.devices $deviceName -}}
{{-   $device = get $omni.devices $deviceName -}}
{{- end -}}
{{- /* Laid over key by key with `set`, never with sprig's merge, which drops false and 0. */ -}}
{{- $settings := deepCopy (omit $omni "devices") -}}
{{- range $key, $value := $device -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{- $llm := includeTemplate "lib-local-llm.tmpl" . | fromJson -}}
{{- $_ := set $settings "gpuModel" $llm.model -}}
{{- $_ := set $settings "gpuWindow" (int $llm.contextTokens) -}}
{{- $_ := set $settings "gpuKeepAlive" $llm.keepAlive -}}
{{- toJson $settings -}}
