{{- /*
  The file git checks SSH commit signatures against: one `<email> <public key>` line per ssh: entry of
  this device's 1Password note. Rendered to ~/.ssh/allowed_signers on Windows and Android and to
  ~/.config/git/allowed_signers on Linux, where .ssh is not deployed; dot_gitconfig.tmpl points
  gpg.ssh.allowedSignersFile at the copy its platform gets.
*/ -}}
{{- $deviceName := .deviceName -}}
{{- $op := includeTemplate "lib-onepassword.tmpl" . | fromJson -}}

{{- warnf "[allowed-signers] fetching Device: %s..." $deviceName -}}
{{- $deviceNotes := "" -}}
{{- range (onepassword (printf "Device: %s" $deviceName) "personal" $op.account).fields -}}
  {{- if and (eq .label "notesPlain") (hasKey . "value") -}}
    {{- $deviceNotes = .value -}}
  {{- end -}}
{{- end -}}
{{- range splitList "\n" $deviceNotes -}}
  {{- $entry := . | trim -}}
  {{- if ne $entry "" -}}
    {{- $type := index (split ":" $entry) "_0" -}}
    {{- $name := trimPrefix (printf "%s:" $type) $entry | trim -}}
    {{- if eq $type "ssh" -}}
      {{- warnf "[allowed-signers] matched \"%s\"" $name -}}
      {{- $item := onepassword $name "Private" $op.account -}}
      {{- $f := dict -}}
      {{- range $item.fields -}}
        {{- if hasKey . "value" -}}
          {{- $_ := set $f .label .value -}}
        {{- end -}}
      {{- end -}}
      {{- printf "%s %s\n" (index $f "ssh email") (index $f "public key") -}}
    {{- end -}}
  {{- end -}}
{{- end }}
