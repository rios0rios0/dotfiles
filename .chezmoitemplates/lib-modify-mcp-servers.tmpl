{{- /*
  Shared MCP server merge for modify_dot_claude.json (~/.claude.json) and
  dot_config/mcphub/modify_servers.json. Both are chezmoi modify-templates, so this
  runs inside chezmoi itself -- no bash, no python3.

  Called through includeTemplate with a dict: "stdin" is the target's current
  content, "os" is .chezmoi.os, and "file" names the target in the log line.

  Each server below is written under "mcpServers", replacing an entry of the same
  name; other servers and every other key are left as they are. When all of them
  already match, the current content is returned byte for byte, so the file keeps
  the layout its owner wrote. Only a real change re-serialises it, and toPrettyJson
  then sorts the keys, because Go maps keep no order.

  Invalid JSON in the target fails the template instead of replacing the file.

  The servers come in groups, and $groupsByOs names the groups each platform gets,
  so a new server or platform is a new entry rather than another branch. See "MCP
  Servers" in CLAUDE.md for why each server has the shape it has.

  Placeholders are always ${VAR}, never ${VAR:-default}: Claude Code expands both,
  but mcp-hub, which reads the same list on Android, looks the second form up as a
  variable named "VAR:-default" and refuses to start the server.
*/ -}}
{{- $groups := dict -}}
{{- /* Remote servers start no process -- nothing against Termux's process budget -- and
       carry their key in a header Claude Code fills in, never on a process's argv. */ -}}
{{- $_ := set $groups "remote" (fromJson `{
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "Authorization": "Bearer ${CONTEXT7_API_KEY}"
    }
  }
}`) -}}
{{- /* Chrome DevTools drives the Google Chrome that run_onchange_after_linux-011-setup-chrome.sh
       installs, so it is Linux only. Pinned rather than @latest: npx would otherwise run
       whatever was published last at every session start. */ -}}
{{- $_ := set $groups "browser" (fromJson `{
  "chrome-devtools": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@1.10.1",
      "--executable-path", "/opt/google/chrome/chrome",
      "--headless",
      "--isolated",
      "--redact-network-headers",
      "--no-usage-statistics",
      "--no-performance-crux"
    ],
    "env": {
      "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
    }
  }
}`) -}}
{{- /* Any other platform gets the remote servers alone. Windows gets neither file: Claude
       Code is not installed there (see .chezmoiignore). */ -}}
{{- $groupsByOs := dict
      "linux" (list "remote" "browser")
      "android" (list "remote") -}}
{{- $servers := dict -}}
{{- range (get $groupsByOs .os | default (list "remote")) -}}
{{-   range $name, $server := get $groups . -}}
{{-     $_ := set $servers $name $server -}}
{{-   end -}}
{{- end -}}
{{- /* Servers this repository used to set, on the platforms it set them on, and has retired.
       The merge leaves every server it does not manage alone, so without this a dropped
       server would stay in each existing file for good. An entry under one of these names on
       its platform is one this merge overwrote on every apply, so it is ours to delete; the
       same name on another platform was never ours. A name that is back in a group wins.
       Retired 2026-10-14 in favour of their CLIs. */ -}}
{{- $desktopRetired := list "github" "azure-devops" "sonarqube" "kubernetes" -}}
{{- $retiredByOs := dict
      "linux" $desktopRetired
      "android" (list "github") -}}
{{- $retired := get $retiredByOs .os | default $desktopRetired -}}
{{- $config := dict -}}
{{- if trim .stdin -}}
{{-   $config = fromJson .stdin -}}
{{- end -}}
{{- $current := dict -}}
{{- if kindIs "map" (get $config "mcpServers") -}}
{{-   $current = get $config "mcpServers" -}}
{{- end -}}
{{- $changed := list -}}
{{- range $name, $server := $servers -}}
{{-   if ne (toJson (get $current $name)) (toJson $server) -}}
{{-     $_ := set $current $name $server -}}
{{-     $changed = append $changed $name -}}
{{-   end -}}
{{- end -}}
{{- $removed := list -}}
{{- range $retired -}}
{{-   if and (hasKey $current .) (not (hasKey $servers .)) -}}
{{-     $_ := unset $current . -}}
{{-     $removed = append $removed . -}}
{{-   end -}}
{{- end -}}
{{- if or $changed $removed -}}
{{-   $_ := set $config "mcpServers" $current -}}
{{-   if $changed -}}
{{-     warnf "[mcp-servers] set %s in %s" (join ", " $changed) .file -}}
{{-   end -}}
{{-   if $removed -}}
{{-     warnf "[mcp-servers] removed %s from %s" (join ", " $removed) .file -}}
{{-   end -}}
{{-   toPrettyJson $config -}}
{{- else -}}
{{-   .stdin -}}
{{- end -}}
