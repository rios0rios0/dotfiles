{{- /* chezmoi:modify-template */ -}}
{{- /*
  Keeps one of two sets of keys in ~/.claude/settings.json, by platform:

  - Linux gets Claude Code's look -- theme, renderer and status line -- from
    lib-claude-look.tmpl. A key whose value differs is set back, so change the look in
    that library, not with /theme.
  - Android gets this repository's permission rules, and effortLevel when it is missing.
    Rules already present, including ones added by hand, keep their place; missing ones
    are appended in the order below, and retired ones are taken out.

  Neither crosses over: Linux never had the rules, and the look's status line forks bash
  and jq on every redraw, which on Termux counts against Android's phantom-process budget.
  Windows gets neither: Claude Code is no longer installed there, and .chezmoiignore keeps
  ~/.claude off it.

  Both platforms get one more key: the Project instructions setting that has Claude Code read
  AGENTS.md beside CLAUDE.md, so the home guide at ~/AGENTS.md reaches every session.

  A modify-template for the reasons given in modify_dot_claude.json at the source
  root, which also explain why it has no .tmpl suffix. When nothing differs, the
  current content is returned byte for byte; a real change re-serialises the file,
  and toPrettyJson then sorts its keys. Invalid JSON fails the template instead of
  replacing the file.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $changed := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $updated := list -}}
{{-   range $key, $value := includeTemplate "lib-claude-look.tmpl" . | fromJson -}}
{{-     if ne (toJson (get $settings $key)) (toJson $value) -}}
{{-       $_ := set $settings $key $value -}}
{{-       $updated = append $updated $key -}}
{{-     end -}}
{{-   end -}}
{{-   if $updated -}}
{{-     warnf "[claude-settings] set %s in ~/.claude/settings.json" (join ", " $updated) -}}
{{-     $changed = true -}}
{{-   end -}}
{{- else -}}
{{-   $rules := list
        "Bash(git:*)" "Bash(chezmoi:*)" "Bash(ls:*)" "Bash(cat:*)" "Bash(head:*)"
        "Bash(tail:*)" "Bash(find:*)" "Bash(grep:*)" "Bash(rg:*)" "Bash(gh:*)"
        "Bash(test:*)" "Bash(echo:*)" "Bash(chmod:*)" "Bash(mkdir:*)" "Bash(cp:*)"
        "Bash(mv:*)" "Read" "Edit" "Write" "Glob" "Grep" "WebSearch" -}}
{{- /* Rules this repository used to append and has retired, taken out wherever they are
       still found, since the append never removes anything. mcp__github__* granted the
       GitHub MCP server's tools; the server was retired on 2026-10-14 (see "MCP Servers" in
       CLAUDE.md), and the rule would otherwise pre-approve any later server of that name. */ -}}
{{-   $retiredRules := list "mcp__github__*" -}}
{{-   if not (hasKey $settings "effortLevel") -}}
{{-     $_ := set $settings "effortLevel" "high" -}}
{{-     $changed = true -}}
{{-   end -}}
{{-   $permissions := dict -}}
{{-   if kindIs "map" (get $settings "permissions") -}}
{{-     $permissions = get $settings "permissions" -}}
{{-   end -}}
{{-   $allow := list -}}
{{-   $retiredFound := list -}}
{{-   if kindIs "slice" (get $permissions "allow") -}}
{{-     range get $permissions "allow" -}}
{{-       if has . $retiredRules -}}
{{-         $retiredFound = append $retiredFound . -}}
{{-       else -}}
{{-         $allow = append $allow . -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $missing := list -}}
{{-   range $rules -}}
{{-     if not (has . $allow) -}}
{{-       $missing = append $missing . -}}
{{-     end -}}
{{-   end -}}
{{-   if or $missing $retiredFound -}}
{{-     $_ := set $permissions "allow" (concat $allow $missing) -}}
{{-     $_ := set $settings "permissions" $permissions -}}
{{-     $changed = true -}}
{{-   end -}}
{{-   if $changed -}}
{{-     warnf "[claude-settings] updated ~/.claude/settings.json (%d permission rules added, %d retired)" (len $missing) (len $retiredFound) -}}
{{-   end -}}
{{- end -}}
{{- /* Both platforms. Claude Code reads AGENTS.md itself (v2.1.277 and later), but by default
       only where no CLAUDE.md sits in the working directory or above it, so a repository with a
       CLAUDE.md of its own would hide the home guide at ~/AGENTS.md. claude-md-and-agents-md has
       it read both, each directory's CLAUDE.md first, and an AGENTS.md that a CLAUDE.md imports
       is not read twice. Only that one option is set: other plugins' entries and this plugin's
       other options stay. The ID is the one v2.1.285 introduced; an older Claude Code reads
       agents-md@builtin and ignores it. See "The Home AGENTS.md" in CLAUDE.md. */ -}}
{{- $agentsPlugin := "cc-plugin-agents-md@builtin" -}}
{{- $instructionFiles := "claude-md-and-agents-md" -}}
{{- $pluginConfigs := dict -}}
{{- if kindIs "map" (get $settings "pluginConfigs") -}}
{{-   $pluginConfigs = get $settings "pluginConfigs" -}}
{{- end -}}
{{- $agentsConfig := dict -}}
{{- if kindIs "map" (get $pluginConfigs $agentsPlugin) -}}
{{-   $agentsConfig = get $pluginConfigs $agentsPlugin -}}
{{- end -}}
{{- $agentsOptions := dict -}}
{{- if kindIs "map" (get $agentsConfig "options") -}}
{{-   $agentsOptions = get $agentsConfig "options" -}}
{{- end -}}
{{- if ne (toJson (get $agentsOptions "instructionFiles")) (toJson $instructionFiles) -}}
{{-   $_ := set $agentsOptions "instructionFiles" $instructionFiles -}}
{{-   $_ := set $agentsConfig "options" $agentsOptions -}}
{{-   $_ := set $pluginConfigs $agentsPlugin $agentsConfig -}}
{{-   $_ := set $settings "pluginConfigs" $pluginConfigs -}}
{{-   warnf "[claude-settings] set pluginConfigs.%s.options.instructionFiles to %s in ~/.claude/settings.json" $agentsPlugin $instructionFiles -}}
{{-   $changed = true -}}
{{- end -}}
{{- if $changed -}}
{{-   toPrettyJson $settings -}}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
