# Copy to .env, generate fresh values, and keep .env private.
# Preserve these values: changing them can invalidate sessions or stored credentials.
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=
STORAGE_ENCRYPTION_KEY=
# Optional CA bundle for outbound HTTPS; defaults to the Linux host trust bundle.
OMNIROUTE_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
